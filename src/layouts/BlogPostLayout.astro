---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import { copy } from '../i18n/copy';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const b = copy.en.blog;
const formattedDate = post.data.date.toLocaleDateString('en-GB', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const isoDate = post.data.date.toISOString();

// Post markdown stays untouched, but a post may open with its own "# Title". The page already has one
// <h1> (the post title in the header band), so a markdown h1 is rendered as h2 here.
const body = (await Astro.slots.render('default')).replace(/<(\/?)h1(?=[\s>])/g, '<$1h2');

const coverImage = await getImage({ src: post.data.cover, width: 1200, format: 'jpg' });
const canonicalURL = new URL(`/blog/${post.id}`, Astro.site).toString();

const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	image: new URL(coverImage.src, Astro.site).toString(),
	datePublished: isoDate,
	dateModified: isoDate,
	mainEntityOfPage: canonicalURL,
	author: {
		'@type': 'Organization',
		name: 'ROBOSECT SRL',
	},
	publisher: {
		'@type': 'Organization',
		name: 'ROBOSECT SRL',
		logo: { '@type': 'ImageObject', url: new URL('/avatar-400.png', Astro.site).toString() },
	},
};
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	lang="en"
	image={{ src: post.data.cover, alt: post.data.coverAlt }}
	type="article"
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} is:inline />
	<PageHeader
		title={post.data.title}
		back={{ href: '/blog', label: b.backToBlog }}
		meta={`${b.publishedOn} ${formattedDate}`}
		metaDatetime={isoDate}
	>
		{
			post.data.tags.length > 0 && (
				<p class="tags">
					<span class="visually-hidden">{b.tagsLabel}: </span>
					{post.data.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</p>
			)
		}
	</PageHeader>
	<article class="post wrap">
		<figure class="post__cover bend" style={`max-width: min(920px, ${post.data.cover.width}px)`}>
			<Image
				src={post.data.cover}
				alt={post.data.coverAlt}
				widths={[480, 720, 960, 1280]}
				sizes="(min-width: 1100px) 860px, 100vw"
				loading="eager"
			/>
		</figure>
		<div class="prose">
			<Fragment set:html={body} />
		</div>
	</article>
</BaseLayout>

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 20px;
	}

	/* a tag is a wire marker: a printed sleeve, as on the home page cable */
	.tag {
		padding: 4px 9px;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--font-mono); /* brand wire-marker face */
		font-size: 13px;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.post {
		padding-block: clamp(40px, 5vw, 72px) clamp(96px, 10vw, 152px);
		background: var(--paper);
	}

	/* never wider than the image itself: small covers (logo artwork) are not blown up into blur. It sits on the page,
	   under the header band (not tucked over its edge) */
	.post__cover {
		max-width: 920px;
		position: relative;
		background: var(--white);
	}

	.post__cover :global(img) {
		width: 100%;
		height: auto;
	}

	.prose {
		max-width: 68ch;
		margin-top: clamp(40px, 5vw, 72px);
		font-size: var(--t-body);
		line-height: 1.7;
	}

	/* post content keeps its own markup; a markdown "# heading" is rendered as h2 (see above) */
	.prose :global(h2) {
		margin: 1.6em 0 0.6em;
		font-size: clamp(24px, 2.2vw, 30px);
		line-height: 1.2;
	}

	.prose > :global(:first-child) {
		margin-top: 0;
	}

	.prose :global(p),
	.prose :global(ul) {
		margin: 0 0 1.1em;
	}

	.prose :global(ul) {
		padding-left: 1.3em;
	}

	.prose :global(li) {
		margin-bottom: 0.5em;
	}

	.prose :global(li::marker) {
		color: var(--blue);
	}

	.prose :global(img) {
		margin: 1.5em 0;
	}
</style>
