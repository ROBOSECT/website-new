---
import logoRaw from '../../assets/brand/robosect-logotipo-negativo-stretto.svg?raw';
import { copy, type Lang } from '../../i18n/copy';
import { homePath, pagePath, sectionHref } from '../../lib/i18n';
import { R_GEOMETRY } from '../../lib/cable-geometry';
import { cablesAt } from '../../lib/menu-cables';

interface Props {
	lang: Lang;
	isHome?: boolean;
	/** a page with the panel and its own Contact (homes, «How it works»): the action goes to the form on the page */
	panel?: boolean;
	/** the nav's own page this is (a link with this `page` is the current page) */
	page?: string;
	/** the same page in the other language, when there is one */
	langHref?: string;
}

const { lang, isHome = false, panel = isHome, page = '', langHref: sameInOther } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'it' ? 'en' : 'it';
// the switch goes to the same page in the other language; on a page that exists in one language only (blog, legal), to the
// other homepage
const langHref = sameInOther ?? homePath(other);
const contactHref = sectionHref(lang, 'contact', panel);
// a link to a place on the home page, or to a page of its own (the bar marks that one as the current page)
const linkHref = (l: { anchor: string; page: string }) => (l.page ? pagePath(lang, l.page) : sectionHref(lang, l.anchor, isHome));
// the panel's main connector in miniature, wordless (a visual only): six ring pins,
// one per compartment whose job the scroll has passed (scripts/panel), the centre pin when the robots have built the Contact
// form. Literal paint
const x0Glyph = `<svg class="x0i" viewBox="-10 -10 20 20" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="0" cy="0" r="9.1" fill="none" stroke="#0D1B2E" stroke-width="1.1" stroke-opacity="0.6"/><circle cx="0.0" cy="-5.6" r="1.55" fill="none" stroke="#0D1B2E" stroke-width="1" stroke-opacity="0.5"/><circle cx="4.85" cy="-2.8" r="1.55" fill="none" stroke="#0D1B2E" stroke-width="1" stroke-opacity="0.5"/><circle cx="4.85" cy="2.8" r="1.55" fill="none" stroke="#0D1B2E" stroke-width="1" stroke-opacity="0.5"/><circle cx="0.0" cy="5.6" r="1.55" fill="none" stroke="#0D1B2E" stroke-width="1" stroke-opacity="0.5"/><circle cx="-4.85" cy="2.8" r="1.55" fill="none" stroke="#0D1B2E" stroke-width="1" stroke-opacity="0.5"/><circle cx="-4.85" cy="-2.8" r="1.55" fill="none" stroke="#0D1B2E" stroke-width="1" stroke-opacity="0.5"/><circle cx="0" cy="0" r="2" fill="none" stroke="#0D1B2E" stroke-width="1.1" stroke-opacity="0.6"/><circle class="x0i__on k1" cx="0.0" cy="-5.6" r="2.05" fill="#0D1B2E" stroke="none"/><circle class="x0i__on k2" cx="4.85" cy="-2.8" r="2.05" fill="#0D1B2E" stroke="none"/><circle class="x0i__on k3" cx="4.85" cy="2.8" r="2.05" fill="#0D1B2E" stroke="none"/><circle class="x0i__on k4" cx="0.0" cy="5.6" r="2.05" fill="#0D1B2E" stroke="none"/><circle class="x0i__on k5" cx="-4.85" cy="2.8" r="2.05" fill="#0D1B2E" stroke="none"/><circle class="x0i__on k6" cx="-4.85" cy="-2.8" r="2.05" fill="#0D1B2E" stroke="none"/><circle class="x0i__on k7" cx="0" cy="0" r="2.55" fill="#0D1B2E" stroke="none"/></svg>`;
// the logotype inline (the logo kit's negativo «-stretto», on ink: same pixels as the file)
const logo = logoRaw
	.replace(/<title>[^<]*<\/title>/, '')
	.replace(/\swidth="[^"]*"\sheight="[^"]*"/, ' width="145" height="22"')
	.replace('role="img" aria-label="ROBOSECT"', 'aria-hidden="true" focusable="false" class="nav__logo"')
	// every shape with literal paint: the asset's paths have their fill; give them their stroke too
	.replaceAll('<path fill=', '<path stroke="none" fill=')
	// hover: a bead of current runs once along the R, foot to ferrule, and the ferrule's copper lights and calms (the
	// brand's «perla di corrente»; scripts/site.ts starts it, CSS below). At rest the bead sits past the path's end: unseen
	.replace('<path stroke="none" fill="#EC8A52"', '<path class="nav__cu" stroke="none" fill="#EC8A52"')
	.replace(
		'</svg>',
		`<path class="nav__bead" d="${R_GEOMETRY.rD}" pathLength="100" fill="none" stroke="#EC8A52" stroke-width="7" stroke-dasharray="9 200" stroke-dashoffset="-100"></path></svg>`,
	);
// the menu button: three small cables at rest (scripts/site.ts bends them into the X)
const cables = cablesAt(0);
const two = (n: number) => String(n).padStart(2, '0');
---

<header class="nav on-dark" data-nav data-x0={panel ? undefined : '7'}>
	<div class="nav__bar wrap">
		<a class="nav__brand" href={homePath(lang)} aria-label={t.a11y.homeLink}>
			<Fragment set:html={logo} />
		</a>

		<nav class="nav__menu" id="site-menu" aria-label={lang === 'it' ? 'Principale' : 'Main'}>
			<span class="nav__edge" aria-hidden="true"></span>
			<p class="nav__mlabel" aria-hidden="true">Menu</p>
			<ul class="nav__links">
				{
					t.nav.links.map((l, i) => (
						<li style={`--i:${i + 1}`}>
							<a href={linkHref(l)} data-nav-link={l.page ? undefined : l.id} aria-current={l.page && l.page === page ? 'page' : undefined}>
								<span class="nav__n" aria-hidden="true">{two(i + 1)}</span>
								<span class="nav__t">{l.label}</span>
							</a>
						</li>
					))
				}
			</ul>
			<a class="nav__lang" href={langHref} hreflang={other} lang={other} aria-label={t.nav.langSwitch.ariaLabel} style={`--i:${t.nav.links.length + 1}`}>
				<span class="nav__lang-long">{t.nav.langSwitch.label}</span>
				<span class="nav__lang-short" aria-hidden="true">{t.nav.langSwitch.short}</span>
			</a>
		</nav>

		<a class="btn btn--sm nav__cta" href={contactHref} data-nav-cta
			><Fragment set:html={x0Glyph} /><span class="nav__cta-long">{t.nav.cta}</span><span class="nav__cta-short">{t.nav.ctaShort}</span><span class="nav__cta-tiny">{t.nav.ctaTiny}</span></a
		>

		<button
			class="nav__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-menu"
			data-open-label={t.a11y.openMenu}
			data-close-label={t.a11y.closeMenu}
		>
			<span class="visually-hidden" data-toggle-label>{t.a11y.openMenu}</span>
			<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" data-cables>
				{
					cables.map((c, i) => (
						<g class="nav__cab" style={`--i:${i}`}>
							<path d={c.cable} fill="none" stroke="#F4F1EC" stroke-width="2" />
							<path d={c.tip} fill="none" stroke="#EC8A52" stroke-width="1.2" />
						</g>
					))
				}
			</svg>
		</button>
	</div>
	<div class="nav__scrim" data-nav-scrim aria-hidden="true"></div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--ink);
		/* the closed drawer waits past the right edge: clipped here, or a phone would widen the page to hold it */
		overflow-x: clip;
	}

	.nav__bar {
		display: flex;
		align-items: center;
		gap: 28px;
		height: var(--nav-h);
	}

	.nav__brand {
		display: flex;
		align-items: center;
		flex: none;
		padding-block: 8px;
		transition:
			opacity 0.3s ease,
			visibility 0s linear 0s;
	}

	.nav__brand :global(.nav__logo) {
		height: 22px;
		width: auto;
	}

	/* the bead of current (hover, keyboard focus): once along the R, foot to ferrule, 0.6 s sine (one beat of the brand
	   grid, 100 BPM); the ferrule's copper lights as it arrives and calms. scripts/site.ts sets data-run and clears it at
	   the end, so a short pass still runs it whole. Reduced motion: no bead, the copper a little brighter while hovered */
	.nav__brand[data-run] :global(.nav__bead) {
		animation: nav-bead 0.6s var(--ease-sine) both;
	}

	.nav__brand[data-run] :global(.nav__cu) {
		animation: nav-cu 0.9s var(--ease-sine) 0.42s both;
	}

	@keyframes nav-bead {
		from {
			stroke-dashoffset: -100;
		}

		to {
			stroke-dashoffset: 9;
		}
	}

	@keyframes nav-cu {
		0%,
		100% {
			fill: #ec8a52;
		}

		30% {
			fill: #ffc39b;
		}
	}

	:global(html:not(.motion)) .nav__brand:is(:hover, :focus-visible) :global(.nav__cu) {
		fill: #f3a170;
	}

	/* one brand on screen: the hero carries only the symbol, so the bar's logo is always there; it leaves while the
	   footer's big wordmark is in view. Hidden also
	   means out of the tab order (visibility), so keyboard focus never lands on it. */
	:global(.js .footer-brand-visible) .nav__brand {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.3s ease,
			visibility 0s linear 0.3s;
	}

	.nav__menu {
		display: flex;
		align-items: center;
		gap: 28px;
		margin-left: auto;
	}

	.nav__links {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 22px;
	}

	.nav__links a,
	.nav__lang {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--paper);
		font-size: 15px;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}

	.nav__links a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 8px;
		height: 2px;
		/* a cable with its copper conductor at the head: scaling from the left, the copper rides the front */
		background: linear-gradient(90deg, var(--paper) calc(100% - 7px), var(--nav-tip) 0);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.2s var(--ease-quad-in);
	}

	.nav__links a:is(:hover, :focus-visible)::after,
	.nav__links a[aria-current]::after {
		transform: scaleX(1);
		transition: transform 0.34s var(--ease-expo-out);
	}

	/* the copper lights while the cable runs, then calms into Carta; the current page's underline is all Carta */
	@property --nav-tip {
		syntax: '<color>';
		inherits: true;
		initial-value: #f4f1ec;
	}

	:global(html.motion) .nav__links a:hover:not([aria-current])::after {
		animation: nav-tip 0.8s linear both;
	}

	@keyframes nav-tip {
		0%,
		45% {
			--nav-tip: #ec8a52;
		}

		100% {
			--nav-tip: #f4f1ec;
		}
	}

	:global(html:not(.motion)) .nav__links a::after {
		transition: none;
	}

	.nav__lang {
		color: var(--paper);
	}

	/* the language switch reads as a control, not as a disabled link: a small sleeve, like a wire marker */
	.nav__lang-short {
		display: inline-flex;
		align-items: center;
		padding: 3px 7px;
		border: 1px solid var(--steel-light);
		font-family: var(--font-mono); /* brand wire-marker face */
		font-size: 13px;
		letter-spacing: 0.06em;
		line-height: 1.2;
		transition:
			border-color 0.2s var(--ease-out),
			background-color 0.2s var(--ease-out),
			box-shadow 0.18s var(--ease-quint-out),
			transform 0.2s var(--ease-quint-out);
	}

	/* the sleeve closes in on hover, as crimped; pressed, it tightens */
	.nav__lang:is(:hover, :focus-visible) .nav__lang-short {
		border-color: var(--paper);
		background: var(--ink-2);
		box-shadow: inset 0 0 0 1px var(--paper);
	}

	:global(html.motion) .nav__lang:active .nav__lang-short {
		transform: scale(0.94);
		transition-duration: 0.1s;
	}

	/* the drawer's parts: only in the drawer (below) */
	.nav__edge,
	.nav__mlabel,
	.nav__n,
	.nav__scrim {
		display: none;
	}

	.nav__lang-long {
		display: none;
	}

	.nav__cta {
		position: relative;
		flex: none;
		gap: 8px;
	}

	/* Contact is the section on screen (scripts/home.ts): the call to action is marked like a current link,
	   with the bar's own Carta underline, just under the button */
	.nav__cta::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -6px;
		height: 2px;
		background: var(--paper);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
		pointer-events: none;
	}

	.nav__cta[aria-current]::after {
		transform: scaleX(1);
	}

	/* the -X0 indicator: a pin lights as each compartment's continuity test passes. Paint is literal on the
	   shapes; CSS only sets the lit discs' opacity. No JS / reduced motion: the tested panel, 6/7 (the seventh
	   connection is the visitor's request) */
	.nav__cta :global(.x0i) {
		flex: none;
		display: block;
	}

	.nav__cta :global(.x0i__on) {
		opacity: 0;
		transition: opacity 0.22s var(--ease-out);
	}

	:global(html:not(.motion)) .nav__cta :global(.x0i__on:not(.k7)),
	.nav[data-x0='1'] :global(.x0i__on.k1),
	.nav[data-x0='2'] :global(.x0i__on:is(.k1, .k2)),
	.nav[data-x0='3'] :global(.x0i__on:is(.k1, .k2, .k3)),
	.nav[data-x0='4'] :global(.x0i__on:is(.k1, .k2, .k3, .k4)),
	.nav[data-x0='5'] :global(.x0i__on:is(.k1, .k2, .k3, .k4, .k5)),
	.nav[data-x0='6'] :global(.x0i__on:is(.k1, .k2, .k3, .k4, .k5, .k6)),
	.nav[data-x0='7'] :global(.x0i__on) {
		opacity: 1;
	}

	.nav__toggle {
		display: none;
		/* (never squeezed by the bar's other items: on a narrow phone it could shrink to 0–11 px) */
		flex: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		margin-right: -10px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--paper);
		cursor: pointer;
		transition: background-color 0.2s var(--ease-out);
	}

	.nav__toggle:hover {
		background: var(--ink-2);
	}

	/* the three cables (their bend into the X is scripts/site.ts): on hover they run forward a little, head first, one
	   after the other */
	.nav__cab {
		transition: transform 0.22s var(--ease-expo-out);
		transition-delay: calc(var(--i) * 45ms);
	}

	:global(html.motion) .nav__toggle[aria-expanded='false']:hover .nav__cab {
		transform: translateX(1.5px);
	}

	@media (max-width: 1099px) {
		.nav__bar {
			gap: 16px;
		}

		.nav__cta {
			margin-left: auto;
		}

		.nav__cta::after {
			bottom: -4px;
		}

		.nav__toggle {
			display: inline-flex;
		}

		/* the menu is a drawer from the right, under the bar (the bar and its X stay on top and usable), over a dim
		   ground: a tap on the ground, Esc or the X close it (scripts/site.ts). It enters with expo-out and leaves with
		   quad-in, never a bounce; its links come in one after the other; a cable runs down its edge, copper first. */
		.nav__menu {
			position: absolute;
			top: 100%;
			right: 0;
			display: flex;
			width: min(400px, calc(100% - 48px));
			height: calc(100svh - var(--nav-h));
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			margin: 0;
			padding: 18px var(--m) 28px 32px;
			background: var(--ink);
			/* over the dim ground (it comes later in the page) */
			z-index: 2;
			overflow-y: auto;
			overscroll-behavior: contain;
			visibility: hidden;
			transform: translateX(100%);
			transition:
				transform 0.3s var(--ease-quad-in),
				visibility 0s linear 0.3s;
		}

		.nav__menu.is-open {
			visibility: visible;
			transform: none;
			transition: transform 0.4s var(--ease-expo-out);
		}

		:global(html:not(.motion)) .nav__menu,
		:global(html:not(.motion)) .nav__menu.is-open {
			transition: none;
		}

		.nav__scrim {
			display: block;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			height: calc(100svh - var(--nav-h));
			z-index: 1;
			background: rgb(8 16 28 / 0.62);
			opacity: 0;
			visibility: hidden;
			/* a scroll container that cannot scroll: a swipe on the ground does not move the page under it */
			overflow: hidden;
			overscroll-behavior: contain;
			transition:
				opacity 0.3s var(--ease-quad-in),
				visibility 0s linear 0.3s;
		}

		.nav__scrim.is-open {
			opacity: 1;
			visibility: visible;
			transition: opacity 0.36s var(--ease-expo-out);
		}

		:global(html:not(.motion)) .nav__scrim {
			transition: none;
		}

		.nav__edge {
			display: block;
			position: absolute;
			left: 0;
			top: 0;
			width: 2px;
			height: 0;
			background: var(--paper);
		}

		/* the conductor at the cable's head: lights while it runs, then calms */
		.nav__edge::after {
			content: '';
			position: absolute;
			left: 0.5px;
			bottom: -3px;
			width: 1px;
			height: 3px;
			background: var(--cu-light);
			opacity: 0;
		}

		.nav__menu.is-open .nav__edge {
			height: 100%;
			transition: height 0.45s var(--ease-expo-out) 0.05s;
		}

		:global(html.motion) .nav__menu.is-open .nav__edge::after {
			animation: nav-edge-cu 0.9s linear 0.05s both;
		}

		@keyframes nav-edge-cu {
			0%,
			50% {
				opacity: 1;
			}

			100% {
				opacity: 0;
			}
		}

		:global(html:not(.motion)) .nav__menu.is-open .nav__edge {
			transition: none;
		}

		.nav__mlabel {
			display: block;
			padding: 4px 0 10px;
			font-family: var(--font-mono); /* brand wire-marker face */
			font-size: 11px;
			font-weight: 500;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--steel-light);
		}

		/* the entrance of the parts, one after the other (motion only) */
		:global(html.motion) .nav__menu :is(.nav__mlabel, .nav__links li, .nav__lang) {
			opacity: 0;
			transform: translateX(20px);
			transition:
				opacity 0.18s var(--ease-quad-in),
				transform 0.2s var(--ease-quad-in);
		}

		:global(html.motion) .nav__menu.is-open :is(.nav__mlabel, .nav__links li, .nav__lang) {
			opacity: 1;
			transform: none;
			transition:
				opacity 0.3s var(--ease-expo-out) calc(80ms + var(--i, 0) * 40ms),
				transform 0.4s var(--ease-expo-out) calc(80ms + var(--i, 0) * 40ms);
		}

		/* the drawer only opens with the script: without it the menu is the compact row below */
		:global(html:not(.js)) .nav__menu {
			visibility: visible;
			transform: none;
			width: auto;
			height: auto;
		}

		:global(html:not(.js)) :is(.nav__mlabel, .nav__edge, .nav__n, .nav__scrim) {
			display: none;
		}

		:global(html:not(.js)) .nav__menu :is(.nav__mlabel, .nav__links li, .nav__lang) {
			opacity: 1;
			transform: none;
		}

		:global(html:not(.js)) .nav__menu {
			position: static;
			min-height: 0;
			max-height: none;
			overflow: visible;
			padding: 4px 0 12px;
		}

		:global(html:not(.js)) .nav__bar {
			flex-wrap: wrap;
			height: auto;
			min-height: var(--nav-h);
		}

		/* without JS the menu cannot open and close: it is a compact row of links in a header that scrolls away with the
		   page (a sticky header holding the expanded menu would cover half the phone screen on every page) */
		:global(html:not(.js)) .nav {
			position: relative;
		}

		:global(html:not(.js)) .nav__links {
			flex-direction: row;
			flex-wrap: wrap;
			column-gap: 20px;
		}

		:global(html:not(.js)) .nav__links a,
		:global(html:not(.js)) .nav__lang {
			min-height: 44px;
			width: auto;
			font-size: 16px;
		}

		:global(html:not(.js)) .nav__lang {
			margin-top: 0;
		}

		/* the bar first (logo and the CTA), the links below it */
		:global(html:not(.js)) .nav__menu {
			order: 3;
			flex-basis: 100%;
		}

		:global(html:not(.js)) .nav__toggle {
			display: none;
		}

		.nav__links {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			border-top: 1px solid var(--ink-2);
		}

		.nav__links li {
			border-bottom: 1px solid var(--ink-2);
		}

		.nav__links a,
		.nav__lang {
			min-height: 52px;
			font-size: 22px;
			width: 100%;
		}

		.nav__links a {
			gap: 14px;
			min-height: 60px;
			letter-spacing: -0.01em;
		}

		.nav__links a::after {
			display: none;
		}

		/* the wire number: mono, like the tags on the panel's wires */
		.nav__n {
			display: inline;
			flex: none;
			width: 18px;
			font-family: var(--font-mono); /* brand wire-marker face */
			font-size: 11px;
			font-weight: 500;
			letter-spacing: 0.06em;
