---
/**
 * The four products, one card each, always in the same order: media, stage, name, what it does, who it is for, action.
 * Texts from copy.pages.products.cards. The media is a key: the Cable Reader render, a still of the CONTEST cell,
 * a drawing for schematic conversion, the tape-threading simulation for the reel-change cell.
 */
import { Image } from 'astro:assets';
import reader from '../../assets/images/products/cable-reader.jpg';
import cell from '../../assets/images/home/demo-two-probes.jpg';
import ReelVideo from './ReelVideo.astro';
import { homePath, pagePath } from '../../lib/i18n';
import type { Lang } from '../../i18n/copy';

interface Card {
	media: 'reader' | 'cell' | 'schemes' | 'reel';
	alt: string;
	status: string;
	name: string;
	line: string;
	forWhom: string;
	cta: string;
	more: string;
}
interface Props {
	lang: Lang;
	forLabel: string;
	cards: readonly Card[];
}
const { lang, forLabel, cards } = Astro.props;
const arrow = 'M2 9h12M9.5 4.5 14 9l-4.5 4.5';
---

<ul class="pc">
	{
		cards.map((c) => (
			<li class="pc__card">
				<div class="pc__media">
					{c.media === 'reader' && <Image src={reader} alt={c.alt} widths={[480, 720, 960]} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw" />}
					{c.media === 'cell' && <Image src={cell} alt={c.alt} widths={[480, 720, 960]} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw" />}
					{c.media === 'reel' && <ReelVideo label={c.alt} lang={lang} />}
					{
						c.media === 'schemes' && (
							<svg viewBox="0 0 432 269" role="img" aria-label={c.alt}>
								<rect width="432" height="269" fill="var(--mist)" />
								<g fill="var(--white)" stroke="var(--steel)" stroke-width="2">
									<rect x="40" y="36" width="132" height="197" />
								</g>
								<g stroke="var(--steel)" stroke-width="3" stroke-linecap="round" fill="none">
									<path d="M60 70h92M60 100h60M60 130h92M60 160h40M60 190h76" />
								</g>
								<path d="M190 134h50M228 120l14 14-14 14" fill="none" stroke="var(--blue)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
								<g fill="var(--white)" stroke="var(--blue)" stroke-width="2">
									<rect x="260" y="60" width="132" height="148" />
								</g>
								<g stroke="var(--blue)" stroke-width="2">
									<path d="M260 96h132M260 132h132M260 168h132M304 60v148" />
								</g>
							</svg>
						)
					}
				</div>
				<div class="pc__body">
					<p class="pc__status">{c.status}</p>
					<h3 class="pc__name">{c.name}</h3>
					<p class="pc__line">{c.line}</p>
					<p class="pc__for"><span>{forLabel}</span> {c.forWhom}</p>
					<p class="pc__actions">
						<a class="text-link" href={`${homePath(lang)}#contact`}>
							{c.cta}
							<svg viewBox="0 0 18 18" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="2"></path></svg>
						</a>
						{c.more ? (
							<a class="text-link" href={pagePath(lang, 'packaging')}>
								{c.more}
								<svg viewBox="0 0 18 18" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="2"></path></svg>
							</a>
						) : null}
					</p>
				</div>
			</li>
		))
	}
</ul>

<style>
	.pc {
		list-style: none;
		display: grid;
		gap: 40px 24px;
		margin-top: 40px;
	}

	.pc__card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		border-top: 4px solid var(--blue);
		padding-top: 18px;
	}

	.pc__media {
		aspect-ratio: 864 / 538;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
	}

	.pc__media :global(img),
	.pc__media :global(svg),
	.pc__media :global(video) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pc__body {
		display: flex;
		flex: 1;
		flex-direction: column;
	}

	.pc__status {
		margin-top: 16px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--blue);
	}

	.pc__name {
		margin-top: 6px;
		font-size: 22px;
		line-height: 1.2;
	}

	.pc__line {
		margin-top: 8px;
		font-size: 16px;
		line-height: 1.5;
	}

	.pc__for {
		margin-top: 10px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--steel);
	}

	.pc__for span {
		font-weight: 600;
	}

	.pc__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-top: auto;
		padding-top: 16px;
	}

	@media (min-width: 700px) {
		.pc {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 48px var(--gap);
		}
	}
</style>
