---
/**
 * Packaging page: the simulation of threading a tape (muted loop, recorded from our own 3D model: scene only, no labels),
 * then the three moments in words (find the tail, take it, thread and join). Texts come from copy.pages.packaging.diagram.
 * It comes after the three steps of the cell, with its own visible title, so the 1-2-3 of the simulation read as a
 * close-up of threading and splicing, not as a second list of steps.
 */
import ReelVideo from './ReelVideo.astro';
interface Step {
	n: string;
	t: string;
	b: string;
}
interface Props {
	title: string;
	desc: string;
	caption: string;
	steps: readonly Step[];
}
const { title, desc, caption, steps } = Astro.props;
---

<figure class="tt" role="group" aria-labelledby="tt-title">
	<h3 id="tt-title" class="tt__h">{title}</h3>
	<p class="tt__desc visually-hidden">{desc}</p>
	<div class="tt__video">
		<ReelVideo label={desc} />
	</div>
	<figcaption class="tt__cap">{caption}</figcaption>
	<ol class="tt__row">
		{
			steps.map((s) => (
				<li class="tt__cell">
					<p class="tt__n" aria-hidden="true">{s.n}</p>
					<h4 class="tt__t">{s.t}</h4>
					<p class="tt__b">{s.b}</p>
				</li>
			))
		}
	</ol>
</figure>

<style>
	.tt {
		margin-top: 64px;
	}

	.tt__h {
		margin-bottom: 16px;
		font-size: 24px;
		line-height: 1.25;
	}

	.tt__video {
		max-width: 960px;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
	}

	.tt__row {
		list-style: none;
		display: grid;
		gap: 24px;
		margin-top: 28px;
	}

	.tt__cell {
		min-width: 0;
		position: relative;
	}

	.tt__n {
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.06em;
		color: var(--steel);
	}

	.tt__t {
		margin-top: 2px;
		font-size: 20px;
		line-height: 1.25;
	}

	.tt__b {
		margin-top: 6px;
		font-size: 16px;
		line-height: 1.5;
	}

	.tt__cap {
		margin-top: 12px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--steel);
		max-width: 60ch;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 700px) {
		.tt__row {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--gap);
		}
	}
</style>
