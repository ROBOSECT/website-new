---
/**
 * The inner pages besides Technology: products, packaging, work with us (copy.pages.<page>). Same bones and same
 * look as the Technology page: header with the intro, three pillars, a section of numbered steps, the closing action.
 */
import { Image } from 'astro:assets';
import setup from '../../assets/images/home/demo-board.jpg';
import TapeThreading from './TapeThreading.astro';
import ProductCards from './ProductCards.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../site/PageHeader.astro';
import Rich from '../ui/Rich.astro';
import { copy, type Lang } from '../../i18n/copy';
import { homePath, pagePath, type PageKey } from '../../lib/i18n';

interface Props {
	lang: Lang;
	page: 'products' | 'packaging' | 'work';
}
const { lang, page } = Astro.props;
const t = copy[lang].pages[page];
// products speak to switchboard builders; the other two to every process
const cta = page === 'products' ? copy[lang].cta : copy[lang].ctaAll;
const key: PageKey = page;
---

<BaseLayout title={t.metaTitle} description={t.metaDescription} lang={lang} alternates={{ en: pagePath('en', key), it: pagePath('it', key) }}>
	<PageHeader title={t.title} intro={t.body} back={{ href: homePath(lang), label: t.back }} />

	<section class="tp tp--intro wrap" aria-label={t.eyebrow}>
		<div class="tp-intro">
			<div class="tp-intro__text">
				<ul class="tp-pillars tp-pillars--first">
					{
						t.pillars.map((p) => (
							<li>
								<h2>{p.title}</h2>
								<p>{p.body}</p>
							</li>
						))
					}
				</ul>
			</div>
			{
				t.photo && (
					<figure class="tp-photo">
						<div class="tp-photo__frame">
							<Image src={setup} alt={t.photo.alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 1100px) 520px, 100vw" loading="eager" />
						</div>
						<figcaption>{t.photo.caption}</figcaption>
					</figure>
				)
			}
		</div>
	</section>

	<section class="tp tp--platform wrap" aria-labelledby="tp-items">
		<h2 id="tp-items" class="tp-h">{t.sectionTitle}</h2>
		<p class="tp-sub">{t.sectionIntro}</p>
		{t.diagram && <TapeThreading {...t.diagram} />}
		{'cards' in t && <ProductCards lang={lang} forLabel={t.forLabel} cards={t.cards} />}
		<ol class="tp-steps tp-steps--3">
			{
				('items' in t ? t.items : []).map((s) => (
					<li class="tp-step">
						{s.number && <p class="tp-step__n" aria-hidden="true">{s.number}</p>}
						<p class="tp-step__k">{s.kicker}</p>
						<h3 class="tp-step__t">{s.title}</h3>
						<p class="tp-step__b">{s.body}</p>
						<ul class="tp-step__specs">
							{s.specs.map((x) => (
								<li><Rich text={x} /></li>
							))}
						</ul>
						{s.cta ? (
							<a class="text-link tp-step__cta" href={`${homePath(lang)}#contact`}>
								{s.cta}
								<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
							</a>
						) : null}
					</li>
				))
			}
		</ol>
		{
			t.targets && (
				<div class="tp-targets">
					<h3>{t.targetsTitle}</h3>
					<p>{t.targets}</p>
				</div>
			)
		}
		{t.note && <p class="tp-note"><Rich text={t.note} /></p>}
	</section>

	<section class="tp-cta on-dark" aria-labelledby="tp-cta">
		<div class="wrap tp-cta__in">
			<h2 id="tp-cta" class="tp-cta__h">{cta.label}</h2>
			<p class="tp-cta__p">{cta.promise}</p>
			<a class="btn" href={`${homePath(lang)}#contact`}>
				{cta.label}
				<svg class="btn__arrow" viewBox="0 0 18 18" aria-hidden="true"
					><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg
				>
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.tp {
		padding-block: clamp(56px, 7vw, 104px);
		background: var(--paper);
	}

	.tp--intro {
		padding-bottom: clamp(40px, 5vw, 72px);
	}

	.tp-intro {
		display: grid;
		gap: 40px;
	}

	.tp-lead {
		font-size: var(--t-lead);
		line-height: 1.5;
		max-width: 38em;
	}

	.tp-pillars {
		list-style: none;
		display: grid;
		gap: 24px;
	}

	.tp-pillars li {
		padding-top: 16px;
		border-top: 2px solid var(--blue);
	}

	.tp-pillars h2 {
		font-size: 20px;
		line-height: 1.25;
	}

	.tp-pillars p {
		margin-top: 6px;
		font-size: 17px;
		line-height: 1.55;
		max-width: 48ch;
	}

	.tp-photo__frame {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
	}

	.tp-photo__frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tp-photo figcaption {
		margin-top: 12px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--steel);
		max-width: 46ch;
	}

	.tp--platform {
		background: var(--white);
	}

	.tp-h {
		font-size: var(--t-h2);
		line-height: 1.1;
		letter-spacing: -0.025em;
		max-width: 20em;
	}

	.tp-sub {
		margin-top: 14px;
		font-size: 17px;
		line-height: 1.55;
		max-width: 46em;
		color: var(--steel);
	}

	.tp-steps {
		list-style: none;
		display: grid;
		gap: 36px;
		margin-top: 40px;
	}

	.tp-step {
		padding-top: 18px;
		border-top: 4px solid var(--blue);
		min-width: 0;
	}

	.tp-step__n {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: var(--steel);
	}

	.tp-step__k {
		margin-top: 4px;
		font-size: 15px;
		font-weight: 600;
		color: var(--blue);
	}

	.tp-step__t {
		margin-top: 6px;
		font-size: 20px;
		line-height: 1.25;
	}

	.tp-step__b {
		margin-top: 10px;
		font-size: 16px;
		line-height: 1.55;
	}

	.tp-step__cta {
		margin-top: 16px;
	}

	.tp-step__specs {
		list-style: none;
		display: grid;
		gap: 8px;
		margin-top: 16px;
		font-size: 15px;
		line-height: 1.4;
		color: var(--steel);
	}

	.tp-step__specs li {
		position: relative;
		padding-left: 20px;
	}

	.tp-step__specs li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 11px;
		height: 3px;
		background: var(--blue);
	}

	.tp-note {
		margin-top: 24px;
		font-size: 15px;
		color: var(--steel);
		max-width: 60ch;
	}

	.tp-targets {
		margin-top: 40px;
		padding: 20px;
		background: var(--white);
		border-left: 4px solid var(--blue);
		max-width: 60ch;
	}

	.tp-targets h3 {
		font-size: 19px;
		line-height: 1.25;
	}

	.tp-targets p {
		margin-top: 6px;
		font-size: 16px;
		line-height: 1.55;
	}

	.tp-apps {
		list-style: none;
		display: grid;
		gap: 4px;
		margin-top: 32px;
	}

	.tp-app {
		display: grid;
		gap: 6px;
		padding: 20px;
		background: var(--white);
	}

	.tp-app h3 {
		font-size: 19px;
		line-height: 1.25;
	}

	.tp-app__s {
		font-size: 14px;
		font-weight: 600;
		color: var(--blue);
	}

	.tp-app__b {
		font-size: 16px;
		line-height: 1.55;
		max-width: 60ch;
	}

	.tp-cta {
		background: var(--blue);
	}

	.tp-cta__in {
		padding-block: clamp(56px, 7vw, 96px);
		display: grid;
		justify-items: start;
		gap: 16px;
	}

	.tp-cta__h {
		font-size: var(--t-h2);
		line-height: 1.1;
		color: var(--paper);
	}

	.tp-cta__p {
		font-size: var(--t-lead);
		line-height: 1.5;
		max-width: 36em;
		color: var(--paper);
		margin-bottom: 12px;
	}

	@media (min-width: 700px) {
		.tp-steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 48px var(--gap);
		}

		.tp-app {
			grid-template-columns: minmax(0, 5fr) minmax(0, 2fr) minmax(0, 7fr);
			gap: 4px var(--gap);
			align-items: baseline;
			padding: 22px 24px;
		}
	}

	@media (min-width: 1100px) {
		.tp-intro {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gap);
			align-items: start;
		}

		.tp-intro__text {
			grid-column: 1 / span 6;
		}

		.tp-photo {
			grid-column: 8 / -1;
		}

		.tp-lead {
			font-size: 20px;
		}

		.tp-steps--3 {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
