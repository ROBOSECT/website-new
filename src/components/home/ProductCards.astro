---
/**
 * The four products of the home's «Solutions», one card each: media, the product's name and stage, what it does (a title
 * in plain words) and one line. Texts from copy.solutions.products.cards. The media is a key: the Cable Reader render, a
 * still of the Quality Control Cell, the rebuilt switchboard for schematic conversion, the tape-threading simulation for
 * the reel-change cell.
 */
import { Image } from 'astro:assets';
import reader from '../../assets/images/products/cable-reader.jpg';
import cell from '../../assets/images/products/quality-control-cell.jpg';
import schemes from '../../assets/images/products/schematic-conversion.jpg';
import ReelVideo from './ReelVideo.astro';
import type { Lang } from '../../i18n/copy';

interface Card {
	media: 'reader' | 'cell' | 'schemes' | 'reel';
	alt: string;
	status: string;
	name: string;
	title: string;
	line: string;
}
interface Props {
	lang: Lang;
	cards: readonly Card[];
	/** on the dark compartment (the home's «Solutions») */
	dark?: boolean;
}
const { lang, cards, dark = false } = Astro.props;
---

<ul class:list={['pc', dark && 'pc--dark']}>
	{
		cards.map((c) => (
			<li class="pc__card">
				<div class="pc__media">
					{c.media === 'reader' && <Image src={reader} alt={c.alt} widths={[480, 720, 960]} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw" />}
					{c.media === 'cell' && <Image class="pc__img--cell" src={cell} alt={c.alt} widths={[480, 720, 960]} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw" />}
					{c.media === 'reel' && <ReelVideo label={c.alt} lang={lang} />}
					{c.media === 'schemes' && <Image src={schemes} alt={c.alt} widths={[480, 720, 960]} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw" />}
				</div>
				<div class="pc__body">
					<p class="pc__status">
						{c.name} · {c.status}
					</p>
					<h3 class="pc__name">{c.title}</h3>
					<p class="pc__line">{c.line}</p>
				</div>
			</li>
		))
	}
</ul>

<style>
	.pc {
		list-style: none;
		display: grid;
		gap: 40px 24px;
		margin-top: 40px;
	}

	.pc__card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		border-top: 4px solid var(--blue);
		padding-top: 18px;
	}

	.pc__media {
		aspect-ratio: 864 / 538;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
	}

	.pc__media :global(img),
		.pc__media :global(video) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* the switchboard and the probe are in the lower part of the still: crop from the top, not the bottom */
	.pc__media :global(img.pc__img--cell) {
		object-position: 50% 78%;
	}

	.pc__body {
		display: flex;
		flex: 1;
		flex-direction: column;
	}

	.pc__status {
		margin-top: 16px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--blue);
	}

	.pc__name {
		margin-top: 6px;
		font-size: 22px;
		line-height: 1.2;
	}

	.pc__line {
		margin-top: 8px;
		font-size: 16px;
		line-height: 1.5;
	}

	/* on the dark compartment */
	.pc--dark .pc__name,
	.pc--dark .pc__line {
		color: var(--paper);
	}

	.pc--dark .pc__status {
		color: var(--steel-light);
	}

	.pc--dark .pc__media {
		background: var(--ink-2);
	}


	@media (min-width: 700px) {
		.pc {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 48px var(--gap);
		}
	}

	@media (min-width: 1100px) {
		.pc {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 48px 20px;
		}
	}
</style>
