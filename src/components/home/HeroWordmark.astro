---
/**
 * The ROBOSECT wordmark (the «Capocorda» logo, the kit's negativo: Carta and rame chiaro) with the cable R drawn as a stroke
 * (not an outline). At rest (without JS, with reduced motion, at the top of the page) it is exactly the logo: the R ends in
 * its crimped ferrule. scripts/panel/hero.ts scrubs the detach with the first ~200 px of scroll: the
 * ferrule is pressed onto the cable, pops, slides off the cable's end and is gone, and a copper bead glides through the R to
 * the stem foot, where the test lead takes over and the cable crosses the page. Scrolling back re-seats it; the static page
 * shows it seated.
 */
import { R_GEOMETRY as G } from '../../lib/cable-geometry';

const vbY = G.top - 0.5;
const vbH = G.bot - G.top + 1;
const F = G.ferrule;
// the bead is the page lead's conductor inside the R: its share of the cable (4.3 px of 10, scripts/panel/index.ts)
const bw = +(G.w * 0.43).toFixed(2);
// its size, from the geometry (layout only, plain numbers: no var() in SVG markup): the R's stroke is the page cable
const size = `--wm-w:${+(G.W / G.w).toFixed(4)};--wm-ar:${G.W} / ${+vbH.toFixed(4)}`;
---

<svg class="hero-wordmark" viewBox={`0 ${vbY} ${G.W} ${vbH}`} role="img" aria-label="ROBOSECT" data-wordmark focusable="false" style={size}>
	{/* paint as literal attributes: Carta letters, cable and collar, rame chiaro copper; CSS sets no paint here */}
	<path class="hw-letters" d={G.letters} fill="#F4F1EC" stroke="none"></path>
	<g class="hw-r">
		<path class="hw-cable" d={G.rD} fill="none" stroke="#F4F1EC" stroke-width={G.w} stroke-linecap="butt" data-hw-r></path>
		<g class="hw-ferrule" data-hw-ferrule>
			<path d={F.collar} fill="#F4F1EC" stroke="none"></path>
			<path d={F.cu} fill="#EC8A52" stroke="none"></path>
		</g>
		<path class="hw-trail" d={G.rD} fill="none" stroke="#EC8A52" stroke-opacity="0.32" stroke-width={bw} stroke-linecap="butt" stroke-dasharray="0 1000" data-hw-trail></path>
		<path class="hw-bead" d={G.rD} fill="none" stroke="#EC8A52" stroke-width={bw} stroke-linecap="butt" stroke-dasharray="0 1000" data-hw-bead></path>
		<g class="hw-spark" transform={`translate(${F.x1 + 2} ${F.y})`} opacity="0" data-hw-spark>
			<line x1="2" y1="-5" x2="5" y2="-10" stroke="#EC8A52" stroke-width="2.2" stroke-linecap="round"></line>
			<line x1="4" y1="0" x2="10" y2="0" stroke="#EC8A52" stroke-width="2.2" stroke-linecap="round"></line>
			<line x1="2" y1="5" x2="5" y2="10" stroke="#EC8A52" stroke-width="2.2" stroke-linecap="round"></line>
		</g>
	</g>
</svg>

<style>
	.hero-wordmark {
		/* stroke of the R = the page cable: width = W / w cable widths (lib/cable-geometry.ts, set above) */
		width: calc(var(--cable-w) * var(--wm-w));
		height: auto;
		aspect-ratio: var(--wm-ar);
		overflow: visible;
	}
</style>
