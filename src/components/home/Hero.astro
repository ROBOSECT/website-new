---
import { getImage } from 'astro:assets';
import HeroSymbol from './HeroSymbol.astro';
import BoardDrawing from './BoardDrawing.astro';
import posterSrc from '../../assets/images/home/demo-poster.jpg';
import videoSrc from '../../assets/videos/robosect_v4.mp4';
import { copy, type Lang } from '../../i18n/copy';
import { R_GEOMETRY as G } from '../../lib/cable-geometry';
import { pagePath } from '../../lib/i18n';

interface Props {
	lang: Lang;
	/** the «How it works» page: its title («Down to the last wire.»), the R smaller, no facts (the cable starts again from it) */
	page?: boolean;
}
const { lang, page = false } = Astro.props;
const h = copy[lang].hero;
const hp = copy[lang].howPage;
const brand = copy[lang].brand;
const cta = copy[lang].cta;
const label = page ? hp.metaTitle : brand.descriptor;
const headline = page ? hp.title : h.headline;
const sub = page ? hp.sub : h.subheadline;
// the symbol's measures in logo-grid units (1 unit = var(--s) px), from the geometry (HeroSymbol's box starts 0.5 above G.top):
// the clear space (the ferrule's length) kept around the R
const wm = `--wm-clear:${G.clear}`;
// the home's opening (19/11/2026): the prototype video on the left, the board tested point by point on the right; from
// there straight to the prototype on the «How it works» page
const m = h.media;
const proofHref = `${pagePath(lang, hp.path)}#${copy[lang].proof.id}`;
const poster = page ? null : await getImage({ src: posterSrc, width: 1280, height: 720, format: 'jpg', quality: 78 });
---

<section class:list={['hero on-dark', page ? 'hero--page' : 'hero--home']} data-hero aria-labelledby="hero-title">
	{/* the test lead leaves the R's stem foot and runs down the lane (scripts/panel/hero.ts) */}
	<svg class="hero__wires" aria-hidden="true" focusable="false" data-hero-wires></svg>
	{/* the same lead laid, in CSS: the static page (no JS, reduced motion, print) shows it; in motion it is the route the script measures */}
	<span class="hero__lead" aria-hidden="true" data-hero-lead><span class="hero__lead-a"></span><span class="hero__lead-b"></span></span>
	<div class="hero__text">
		<p class="hero__brand" data-hero-brand style={wm}>
			<HeroSymbol />
			<span class="hero__descriptor">{label}</span>
		</p>
		<h1 id="hero-title" class="hero__title">{headline}</h1>
		<p class="hero__sub">{sub}</p>
		<div class="hero__actions">
			<a class="btn" href={h.primaryCta.href}>
				{h.primaryCta.label}
				<svg class="btn__arrow" viewBox="0 0 18 18" aria-hidden="true"
					><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg
				>
			</a>
		</div>
		<p class="hero__promise">{cta.promise}</p>
		{
			!page && (
				<ul class="hero__facts">
					{h.proofChips.map((c) => <li>{c}</li>)}
				</ul>
			)
		}
		{
			!page && poster && (
				<div class="hero__media" data-hero-media>
					<figure class="hm hm--video">
						<a class="hm__frame" href={proofHref} aria-label={m.videoLabel}>
							{/* muted, in a loop, while on screen (scripts/home.ts); reduced motion, data saver, no JS: the poster */}
							<video class="hm__video" width="1920" height="1080" muted loop playsinline preload="none" poster={poster.src} aria-hidden="true" tabindex="-1" data-autoplay>
								<source src={videoSrc} type="video/mp4" />
							</video>
						</a>
						<figcaption>
							<a class="hm__go" href={proofHref}>
								{m.go}
								<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
							</a>
						</figcaption>
					</figure>
					<figure class="hm hm--board" data-sb-loop>
						<div class="hm__frame hm__frame--board">
							<BoardDrawing />
						</div>
						<figcaption class="hm__cap">
							<span>{m.board}</span>
							<button class="hm__pause" type="button" hidden data-hero-pause data-pause={m.pause} data-play={m.play} data-pause-label={m.pauseLabel} data-play-label={m.playLabel} aria-label={m.pauseLabel}>
								<svg viewBox="0 0 12 12" aria-hidden="true"><path class="hm__ico-pause" d="M3 2h2v8H3zM7 2h2v8H7z" fill="currentColor"></path><path class="hm__ico-play" d="M3 2l7 4-7 4z" fill="currentColor"></path></svg>
								<span>{m.pause}</span>
							</button>
						</figcaption>
					</figure>
				</div>
			)
		}
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		background: var(--ink);
		overflow: hidden;
	}

	.hero__wires {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 3;
		width: 100%;
		height: 100%;
		overflow: hidden;
		pointer-events: none;
	}

	.hero__text {
		position: relative;
		z-index: 2;
		padding: 36px var(--m) 64px;
	}

	/* one unit of the logo grid in px: the R's stroke is 12 units. Phones: the R stands centred above the title;
	   tablet: above the title on the text edge */
	.hero {
		--s: 1.8px;
	}

	.hero__brand {
		position: relative;
		display: flex;
		flex-direction: column;
		/* the descriptor stays out of the symbol's clear space (the ferrule's length; its line box carries ≈ 6 px above the letters) */
		gap: max(14px, calc(var(--s) * var(--wm-clear) - 6px));
	}

	.hero__descriptor {
		font-size: 15px;
		font-weight: 500;
		color: var(--steel-light);
		text-wrap: balance;
	}

	@media (min-width: 700px) {
		.hero {
			--s: 2.4px;
		}
	}

	@media (max-width: 699px) {
		.hero__brand {
			align-items: center;
			text-align: center;
		}
	}

	/* The lead laid, shown on the static page (no JS, reduced motion, print); in motion scripts/panel/hero.ts measures
	   these two boxes for its route and draws it instead.
	   A: from the mouth of the fitting under the stem foot (--fy = the foot + 10 units less 0.4, right border) down to the run (bottom border, bend --j), B: the bend into the lane and
	   the lane down to the hero's edge (left and top borders). The run sits right under the R (phones, tablet) or along
	   the hero's foot (desktops). Borders are centred on the route: every edge is offset by half the cable. */
	.hero__lead {
		--cw: var(--cable-w);
		--j: var(--bend);
		--fy: calc(36px + 108.02 * var(--s));
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		pointer-events: none;
	}

	:global(html.motion) .hero__lead {
		visibility: hidden;
	}

	.hero__lead-a,
	.hero__lead-b {
		position: absolute;
		border: 0 solid #f4f1ec;
	}

	.hero__lead-a {
		left: calc(var(--lane) + var(--j));
		right: calc(50% + 32 * var(--s) - var(--cw) / 2);
		top: var(--fy);
		height: calc(var(--j) + 2px + var(--cw) / 2);
		border-right-width: var(--cw);
		border-bottom-width: var(--cw);
		border-bottom-right-radius: calc(var(--j) + var(--cw) / 2);
	}

	.hero__lead-b {
		left: calc(var(--lane) - var(--cw) / 2);
		width: calc(var(--j) + var(--cw) / 2);
		top: calc(var(--fy) + var(--j) + 2px - var(--cw) / 2);
		bottom: -1px;
		border-left-width: var(--cw);
		border-top-width: var(--cw);
		border-top-left-radius: calc(var(--j) + var(--cw) / 2);
	}

	@media (min-width: 700px) and (max-width: 1099px) {
		/* the stem sits close to the lane: the two bends share the gap (an S), each at most the page's bend */
		.hero__lead {
			--j: min(var(--bend), calc((var(--m) + 6 * var(--s) - var(--lane)) / 2 - 0.5px));
		}

		.hero__lead-a {
			right: calc(100% - var(--m) - 6 * var(--s) - var(--cw) / 2);
		}
	}

	.hero__brand :global(.hero-symbol) {
		position: relative;
		z-index: 2;
	}

	.hero__title {
		margin-top: clamp(36px, 5vw, 72px);
		max-width: 12em;
	}

	.hero__sub {
		margin-top: 24px;
		max-width: 34em;
		font-size: var(--t-lead);
		line-height: 1.55;
		color: var(--paper);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px 28px;
		margin-top: 36px;
	}

	.hero__promise {
		margin-top: 14px;
		max-width: 34em;
		font-size: 15px;
		line-height: 1.45;
		color: var(--steel-light);
	}

	/* every other process: one quiet line under the switchboard promise */
	.hero__other {
		margin-top: 10px;
		max-width: 34em;
		font-size: 15px;
		line-height: 1.45;
		color: var(--steel-light);
	}

	.hero__other a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--paper);
		font-weight: 600;
		text-underline-offset: 0.2em;
	}

	.hero__other svg {
		width: 15px;
		height: 15px;
	}

	.hero__facts {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 8px 28px;
		margin-top: 44px;
		font-size: 15px;
		color: var(--steel-light);
	}

	.hero__facts li {
		position: relative;
		padding-left: 22px;
	}

	.hero__facts li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 12px;
		height: 3px;
		background: var(--steel-light);
	}

	@media (max-width: 699px) {
		.hero__actions .btn {
			width: 100%;
		}
	}

	@media (min-width: 1100px) {
		/* the symbol in large in the right half (the R of the logo, as the kit draws it, its stroke the page cable made big, 12
		   units wide): the brand block dissolves into the text column (the descriptor stays with the headline), the R hangs
		   top right on the nav's right margin. The text column stops one clear space (30 units) short of it. Its lead leaves
		   the stem foot, drops down, bends left under the text and joins the lane (scripts/panel/hero.ts, «far» route) */
		.hero--page {
			--wm-top: clamp(150px, 15svh, 200px);
			min-height: min(calc(100svh - var(--nav-h)), 900px);
			--s: min(5px, calc((100vw - 2 * var(--m) - 520px) / 106));
			--tw: min(640px, calc(100vw - 2 * var(--m) - 106 * var(--s)));
		}

		.hero--page .hero__brand {
			display: contents;
		}

		.hero--page .hero__brand :global(.hero-symbol) {
			position: absolute;
			right: var(--m);
			top: var(--wm-top, 200px);
		}

		.hero--page .hero__text .hero__descriptor {
			margin-left: 0;
		}

		.hero--page .hero__text > :not(.hero__facts) {
			max-width: var(--tw);
		}

		.hero--page .hero__text {
			display: flex;
			flex-direction: column;
			justify-content: flex-start;
			padding: clamp(96px, 15svh, 140px) 56px 84px var(--m);
		}

		/* the lead drops from the stem foot to the hero's foot, runs left under the text and bends down the lane */
		.hero--page .hero__lead {
			--fy: calc(var(--wm-top) + 108.02 * var(--s));
		}

		.hero--page .hero__lead-a {
			right: calc(var(--m) + 70 * var(--s) - var(--cw) / 2);
			height: auto;
			bottom: calc(var(--j) + 2px - var(--cw) / 2);
		}

		.hero--page .hero__lead-b {
			top: auto;
			height: calc(var(--j) + 3px + var(--cw) / 2);
		}

		.hero--page .hero__title {
			margin-top: clamp(24px, calc(4.2vw - 12px), 48px);
		}
	}

	/* desktops at least 860 px tall: the wordmark sits lower, the whole R in view while its lead runs out. The room comes
	   from the facts, which move up into the nameplate's head as one mono plate line (as each compartment opens on its
	   plate line); the words and the primary action stay above the fold, EN and IT (the padding is fitted to the longest
	   Italian lead: its action ends ≥ 24 px above the fold at 1536 × 864 and 1440 × 900). Shorter desktops keep the layout
	   above (the facts under the actions). */
	@media (min-width: 1100px) and (min-height: 860px) {
		.hero--page {
			--wm-top: calc(clamp(168px, calc(108svh - 750px), 300px) + 8px);
		}

		.hero--page .hero__text {
			padding-top: clamp(168px, calc(108svh - 750px), 300px);
		}

		.hero--page .hero__facts {
			position: absolute;
			top: var(--pad-top);
			left: var(--m);
			right: 56px;
			margin-top: 0;
			gap: 8px 22px;
			font-family: var(--font-mono); /* the nameplate's plate line, the brand's tag face */
			font-size: 12px;
			font-weight: 500;
			line-height: 1.5;
			letter-spacing: 0.07em;
			text-transform: uppercase;
		}

		.hero--page .hero__facts li {
			padding-left: 18px;
		}

		.hero--page .hero__facts li::before {
			top: 0.62em;
			width: 10px;
			height: 2px;
		}

		/* on wide, not so tall screens (1536 × 864, 1920 × 900) the headline does not grow past its 900 px-tall size, so
		   the action stays clear of the fold */
		.hero--page .hero__title {
			margin-top: 32px;
			font-size: clamp(2.5rem, min(4.4vw, 7.05svh), 4.25rem);
		}
	}

	/* the «How it works» page: the R in large on the right, as the home had it until 19/11/2026 (the rules above, now
	   for the page only), shorter, the R smaller (its lead runs to the lane) */
	@media (min-width: 1100px) {
		.hero--page {
			--wm-top: clamp(96px, 12svh, 132px);
			--s: min(3.2px, calc((100vw - 2 * var(--m) - 520px) / 106));
			min-height: min(calc(72svh - var(--nav-h)), 640px);
		}

		.hero--page .hero__text {
			padding-top: clamp(80px, 11svh, 120px);
			padding-bottom: 72px;
		}
	}

	@media (min-width: 1100px) and (min-height: 860px) {
		.hero--page {
			--wm-top: clamp(110px, 13svh, 150px);
		}

		.hero--page .hero__text {
			padding-top: clamp(96px, 12svh, 140px);
		}
	}
	/* ---------------- the home's opening (19/11/2026): the prototype video on the left, the board tested point by point
	   on the right, the way to the prototype under the video. Phones: one under the other, after the action. */
	.hero__media {
		display: grid;
		gap: 28px;
		margin-top: 44px;
	}

	.hm {
		min-width: 0;
	}

	.hm__frame {
		position: relative;
		display: block;
		overflow: hidden;
		background: var(--ink-2);
	}

	.hm--video .hm__frame {
		aspect-ratio: 16 / 9;
	}

	.hm__video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hm__frame--board {
		aspect-ratio: 480 / 330;
		background: none;
	}

	.hm figcaption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 16px;
		margin-top: 12px;
		font-size: 15px;
		line-height: 1.4;
		color: var(--steel-light);
	}

	.hm__go {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 32px;
		color: var(--paper);
		font-weight: 600;
		text-underline-offset: 0.2em;
	}

	.hm__go svg {
		width: 16px;
		height: 16px;
		transition: transform 0.2s;
	}

	.hm__go:hover svg {
		transform: translateX(3px);
	}

	.hm__pause {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 32px;
		padding: 0 10px;
		border: 1px solid var(--steel);
		background: none;
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.hm__pause[hidden] {
		display: none;
	}

	.hm__pause:hover {
		border-color: var(--paper);
	}

	.hm__pause svg {
		width: 11px;
		height: 11px;
	}

	.hm__ico-play,
	[data-paused] .hm__ico-pause {
		display: none;
	}

	[data-paused] .hm__ico-play {
		display: inline;
	}

	@media (min-width: 700px) {
		.hero__media {
			grid-template-columns: minmax(0, 16fr) minmax(0, 13.09fr);
			gap: 28px 32px;
		}
	}

	/* from 900 px: the R small on the left of the words (its lead drops into the lane right away, as on tablets), the two
	   pictures across the whole width under them. Desktops (from 1100 px) put the action on the right: all of it in the
	   first screen at 1440 × 900 and 1280 × 720 (the pictures take the height that is left, between 220 and 400 px) */
	@media (min-width: 900px) {
		.hero--home {
			--s: 1.3px;
			--top: clamp(84px, 11svh, 112px);
			--mh: clamp(220px, calc(100svh - 540px), 400px);
		}

		.hero--home .hero__text {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			column-gap: 40px;
			align-items: start;
			padding: var(--top) var(--m) 56px;
		}

		.hero--home .hero__brand {
			display: contents;
		}

		.hero--home .hero__brand :global(.hero-symbol) {
			grid-column: 1;
			grid-row: 1 / span 3;
		}

		.hero--home .hero__descriptor {
			grid-column: 2;
			grid-row: 1;
		}

		.hero--home .hero__title {
			grid-column: 2;
			grid-row: 2;
			max-width: 15em;
			margin-top: 12px;
			font-size: clamp(2.5rem, 3.5vw, 3.4rem);
			text-wrap: balance;
		}

		.hero--home .hero__sub {
			grid-column: 2;
			grid-row: 3;
			margin-top: 16px;
		}

		.hero--home .hero__actions {
			grid-column: 2;
			grid-row: 4;
			margin-top: 28px;
		}

		.hero--home .hero__promise {
			grid-column: 2;
			grid-row: 5;
		}

		.hero--home .hero__facts {
			position: absolute;
			top: var(--pad-top);
			left: var(--m);
			right: var(--m);
			margin-top: 0;
			gap: 8px 22px;
			font-family: var(--font-mono);
			font-size: 12px;
			font-weight: 500;
			line-height: 1.5;
			letter-spacing: 0.07em;
			text-transform: uppercase;
		}

		.hero--home .hero__facts li {
			padding-left: 18px;
		}

		.hero--home .hero__facts li::before {
			top: 0.62em;
			width: 10px;
			height: 2px;
		}

		.hero--home .hero__media {
			grid-column: 1 / -1;
			grid-row: 6;
			width: 100%;
			max-width: calc(var(--mh) * 3.2323 + 32px);
			margin-top: 40px;
		}

		/* the lead: from the stem foot (the R's top is the text's top) an S into the lane, then down beside the pictures */
		.hero--home .hero__lead {
			--fy: calc(var(--top) + 108.02 * var(--s));
			--j: min(var(--bend), calc((var(--m) + 6 * var(--s) - var(--lane)) / 2 - 0.5px));
		}

		.hero--home .hero__lead-a {
			right: calc(100% - var(--m) - 6 * var(--s) - var(--cw) / 2);
		}
	}

	@media (min-width: 1100px) {
		.hero--home .hero__text {
			grid-template-columns: auto minmax(0, 1fr) auto;
		}

		.hero--home .hero__actions {
			grid-column: 3;
			grid-row: 2;
			align-self: end;
			margin-top: 0;
		}

		.hero--home .hero__promise {
			grid-column: 3;
			grid-row: 3;
			max-width: 17em;
			margin-top: 16px;
		}

		.hero--home .hero__media {
			grid-row: 4;
		}
	}
</style>
