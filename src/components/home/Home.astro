---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Problem from './Problem.astro';
import Process from './Process.astro';
import Benefits from './Benefits.astro';
import Proof from './Proof.astro';
import AlsoFor from './AlsoFor.astro';
import Team from './Team.astro';
import Contact from './Contact.astro';
import HomeNews from './HomeNews.astro';
import { type Lang } from '../../i18n/copy';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
// The home page is an electrical panel under test: every section is a compartment
// (+C1…+C7) on one mounting plate, and the copper of the R leads the test cable through all of them.
// Order (for switchboard builders): problem · how it works · what you get · prototype (proof) · also for you · team ·
// contact (the tagline, then the form); then the latest news, a plain section.
// The visitor's scroll drives everything (scripts/panel).
---

<BaseLayout lang={lang} isHome alternates={{ en: '/', it: '/it/' }}>
	<Hero lang={lang} />
	<div class="cab" data-cab>
		<div class="sduct sduct--l" aria-hidden="true"></div>
		<div class="sduct sduct--r" aria-hidden="true"></div>
		<Problem lang={lang} />
		<Process lang={lang} />
		<Benefits lang={lang} />
		<Proof lang={lang} />
		<AlsoFor lang={lang} />
		<Team lang={lang} />
		<Contact lang={lang} />
		<div class="cab__close" aria-hidden="true"></div>
	</div>
	{/* the latest news: a plain section after the panel */}
	<HomeNews lang={lang} />
</BaseLayout>

<script>
	import '../../scripts/home';
</script>

