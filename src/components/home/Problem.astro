---
import { Image } from 'astro:assets';
import imgBoard from '../../assets/images/home/demo-board.jpg';
import imgVariant from '../../assets/images/home/demo-located.jpg';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const p = copy[lang].problem;

const L = {
	en: {
		alts: [
			'An electrical switchboard seen from above: modules, terminal blocks and a socket, wired in blue between grey ducts',
			'The same switchboard as the robot’s vision sees it: each of its 25 components outlined in green where it was found',
		],
		list: 'Drawing of a connection list ticked by hand: some rows have a tick, two are blank',
	},
	it: {
		alts: [
			'Un quadro elettrico visto dall’alto: moduli, morsettiere e una presa, cablati in blu tra canaline grigie',
			'Lo stesso quadro come lo vede la visione del robot: ciascuno dei 25 componenti contornato in verde dove è stato trovato',
		],
		list: 'Disegno di una lista collegamenti spuntata a mano: alcune righe hanno il segno, due sono vuote',
	},
}[lang];
const images = [imgBoard, imgVariant];
// the hand-ticked list: rows (y), ticked or left blank
const rows = [0, 1, 2, 3, 4, 5].map((i) => ({ y: 58 + i * 34, tick: i !== 2 && i !== 4, w: [150, 120, 168, 136, 156, 112][i] }));
---

<Compartment n={1} lang={lang} id={p.id} name={p.eyebrow} title={p.title} intro={p.intro} ground="light">
	<ul class="pts">
		{
			p.points.map((pt, i) => (
				<li class="pt" data-b>
					<figure class="pt__img">
						{images[i] ? (
							<Image src={images[i]!} alt={L.alts[i]} widths={[320, 480, 720]} sizes="(min-width: 1100px) 400px, (min-width: 700px) 30vw, 104px" loading="lazy" />
						) : (
							<svg class="pt__list" viewBox="0 0 320 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label={L.list}>
								<rect x="0" y="0" width="320" height="260" fill="#E2E6EB" stroke="none" />
								<rect x="48" y="24" width="224" height="236" fill="#FFFFFF" stroke="none" />
								<rect x="72" y="34" width="96" height="6" fill="#5A6676" stroke="none" />
								{rows.map((r) => (
									<g>
										<rect x="72" y={r.y} width="14" height="14" fill="none" stroke="#5A6676" stroke-width="2" />
										<rect x="98" y={r.y + 5} width={r.w} height="4" fill="#9AA6B5" stroke="none" />
										{r.tick ? (
											<path d={`M74 ${r.y + 7} l4 5 l8 -11`} fill="none" stroke="#0D1B2E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
										) : (
											<rect x="66" y={r.y - 6} width="26" height="26" fill="none" stroke="#173C78" stroke-width="2" stroke-dasharray="4 3" />
										)}
									</g>
								))}
							</svg>
						)}
					</figure>
					<div class="pt__text">
						<h3>{pt.title}</h3>
						<p>{pt.body}</p>
					</div>
				</li>
			))
		}
	</ul>
	<p class="closing" data-b>{p.closing}</p>
</Compartment>

<style>
	.pts {
		list-style: none;
		display: grid;
		gap: 28px;
	}

	.pt {
		display: grid;
		grid-template-columns: 104px minmax(0, 1fr);
		gap: 16px;
		align-items: start;
	}

	.pt__img {
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
	}

	.pt__img :global(img),
	.pt__list {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pt h3 {
		font-size: 18px;
		line-height: 1.25;
	}

	.pt p {
		margin-top: 6px;
		font-size: 16px;
		line-height: 1.55;
	}

	.closing {
		margin-top: 40px;
		max-width: 22em;
		font-size: 22px;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--blue);
	}

	@media (min-width: 700px) {
		.pts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 40px var(--gap);
		}

		.pt {
			grid-template-columns: minmax(0, 1fr);
			gap: 18px;
		}

		.pt__img {
			aspect-ratio: 4 / 3;
		}

		.pt h3 {
			font-size: 20px;
		}

		.closing {
			margin-top: 56px;
			font-size: 28px;
		}
	}

	@media (min-width: 1100px) {
		.pts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.pt p {
			font-size: 17px;
		}

		.closing {
			margin-top: 64px;
			font-size: 32px;
			max-width: 24em;
		}
	}
</style>
