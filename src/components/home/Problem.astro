---
import { Image } from 'astro:assets';
import imgVision from '../../assets/images/home/demo-located.jpg';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const p = copy[lang].problem;

const alt = {
	en: 'The switchboard as the robot’s vision sees it: each of its 25 components outlined in green where it was found',
	it: 'Il quadro come lo vede la visione del robot: ciascuno dei 25 componenti contornato in verde dove è stato trovato',
}[lang];
---

<Compartment n={1} lang={lang} id={p.id} name={p.eyebrow} title={p.title} intro={p.intro} ground="light">
	<div class="pts">
		<figure class="pts__img" data-b>
			<Image src={imgVision} alt={alt} widths={[480, 720, 960]} sizes="(min-width: 1100px) 560px, (min-width: 700px) 90vw, 100vw" loading="lazy" />
		</figure>
		{
			p.points.map((pt, i) => (
				<div class={`pt pt--${i + 1}`} data-b>
					<h3>{pt.title}</h3>
					<p>{pt.body}</p>
				</div>
			))
		}
	</div>
	<p class="closing" data-b>{p.closing}</p>
</Compartment>

<style>
	.pts {
		display: grid;
		gap: 28px;
	}

	.pts__img {
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
		aspect-ratio: 4 / 3;
	}

	.pts__img :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pt h3 {
		font-size: 18px;
		line-height: 1.25;
	}

	.pt p {
		margin-top: 6px;
		font-size: 16px;
		line-height: 1.55;
	}

	.closing {
		margin-top: 40px;
		max-width: 22em;
		font-size: 22px;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--blue);
	}

	/* tablet: the photo across the top, the three problems in a row under it */
	@media (min-width: 700px) {
		.pts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 32px var(--gap);
		}

		.pts__img {
			grid-column: 1 / -1;
			aspect-ratio: 16 / 7;
		}

		.pt h3 {
			font-size: 20px;
		}

		.closing {
			margin-top: 56px;
			font-size: 28px;
		}
	}

	/* desktop: the photo in the middle, two problems on its left, one on its right */
	@media (min-width: 1100px) {
		.pts {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr) minmax(0, 1fr);
			grid-template-rows: auto auto;
			align-items: center;
			gap: 40px var(--gap);
		}

		.pts__img {
			grid-column: 2;
			grid-row: 1 / 3;
			aspect-ratio: 4 / 3;
		}

		.pt--1 {
			grid-column: 1;
			grid-row: 1;
		}

		.pt--2 {
			grid-column: 1;
			grid-row: 2;
		}

		.pt--3 {
			grid-column: 3;
			grid-row: 1 / 3;
		}

		.pt p {
			font-size: 17px;
		}

		.closing {
			margin-top: 64px;
			font-size: 32px;
			max-width: 24em;
		}
	}
</style>
