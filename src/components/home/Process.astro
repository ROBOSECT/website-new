---
/**
 * How it works, the first compartment of the «How it works» page: the three pillars applied to switchboard testing (sees
 * the real board · starts from your connection list · leaves the test report), then one drawing that shows it: a switchboard whose test points light up one by one
 * while the test report fills in line by line beside it. The rows are illustrative, in words (no device codes on screen).
 * The animation runs once when the drawing is on screen and open (scripts/home.ts sets data-run); without JS and with
 * reduced motion the drawing is shown finished: every point tested, the report complete.
 * (+C3's vignette: the probe tests the last terminals and the printer prints the report: the page's first scene runs from
 * left to right, as the cable leaves the opening.)
 */
import Compartment from '../panel/Compartment.astro';
import BoardDrawing from './BoardDrawing.astro';
import { copy, type Lang } from '../../i18n/copy';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const p = copy[lang].process;
const d = p.demo;
---

<Compartment n={3} lang={lang} id={p.id} name={p.eyebrow} title={p.title} intro={p.intro} ground="light">
	<ol class="steps">
		{
			p.steps.map((s) => (
				<li class="step" data-b data-keep>
					<p class="step__n" aria-hidden="true">{s.number}</p>
					<h3 class="step__title">{s.title}</h3>
					<p class="step__body">{s.body}</p>
				</li>
			))
		}
	</ol>

	<figure class="demo" data-b data-sb aria-label={d.label}>
		<div class="demo__board">
			<BoardDrawing />
		</div>
		<div class="rep">
			<p class="rep__title">{d.reportTitle}</p>
			<p class="rep__sub">{d.reportSub}</p>
			<ol class="rep__rows">
				{
					d.rows.map((r, i) => (
						<li class="rep__row" style={`--i:${i}`}>
							<span class="rep__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<span class="rep__c">
								<span class="rep__end">{r[0]}</span>
								<span class="rep__to" aria-hidden="true">→</span>
								<span class="visually-hidden"> {d.to} </span>
								<span class="rep__end">{r[1]}</span>
							</span>
							<span class="rep__ok">
								<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 7.5l3 3 6-7" fill="none" stroke="#A04A1B" stroke-width="2.2" /></svg>
								{d.result}
							</span>
						</li>
					))
				}
			</ol>
			<p class="rep__sum" style={`--i:${d.rows.length}`}>{d.summary}</p>
		</div>
		<figcaption class="demo__cap">{d.caption}</figcaption>
	</figure>

	<p class="tech-line" data-b>{p.techLine.text}</p>
</Compartment>

<style>
	.steps {
		list-style: none;
		display: grid;
		gap: 32px;
	}

	.step {
		min-width: 0;
		padding-top: 16px;
		border-top: 4px solid var(--blue);
	}

	.step__n {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: var(--steel);
	}

	.step__title {
		margin-top: 6px;
		font-size: 20px;
		line-height: 1.25;
	}

	.step__body {
		margin-top: 8px;
		font-size: 16px;
		line-height: 1.55;
	}

	/* ---------------- the drawing: the board and its report */
	.demo {
		display: grid;
		gap: 16px;
		margin-top: 48px;
		padding: 16px;
		background: var(--white);
	}

	.rep {
		min-width: 0;
	}

	.rep__title {
		font-size: 18px;
		font-weight: 600;
		line-height: 1.25;
	}

	.rep__sub {
		margin-top: 2px;
		font-size: 14px;
		line-height: 1.4;
		color: var(--steel);
	}

	.rep__rows {
		list-style: none;
		margin-top: 12px;
		border-top: 2px solid var(--blue);
	}

	.rep__row {
		display: grid;
		grid-template-columns: 26px minmax(0, 1fr) auto;
		gap: 10px;
		align-items: baseline;
		padding: 6px 0;
		border-bottom: 1px solid var(--mist);
		font-size: 14px;
		line-height: 1.35;
	}

	.rep__n {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--steel);
	}

	.rep__end {
		display: inline-block;
	}

	.rep__to {
		margin-inline: 0.35em;
		color: var(--steel);
	}

	.rep__ok {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		color: var(--cu-deep);
	}

	.rep__ok svg {
		width: 13px;
		height: 13px;
	}

	.rep__sum {
		margin-top: 10px;
		font-size: 14px;
		font-weight: 600;
		color: var(--ink);
	}

	.demo__cap {
		font-size: 13.5px;
		line-height: 1.4;
		color: var(--steel);
	}

	/* the run (motion allowed, on screen, the module open): each test point lights, its ring pulses, its row is written */
	@media (prefers-reduced-motion: no-preference) {
		/* in motion, before its run: untested, the report empty (scripts/home.ts starts it) */
		:global(html.motion) .demo:not([data-run]) :is(.rep__row, .rep__sum) {
			opacity: 0;
		}

		.demo[data-run] .rep__row,
		.demo[data-run] .rep__sum {
			animation: sb-row 0.35s calc(0.55s + var(--i) * 0.75s) both;
		}
	}

	@keyframes sb-row {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.tech-line {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 20px;
		margin-top: 40px;
		font-size: 17px;
		line-height: 1.5;
	}

	@media (min-width: 700px) {
		.steps {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 32px var(--gap);
		}

		.demo {
			grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
			gap: 24px 28px;
			padding: 24px;
		}

		.demo__cap {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 1100px) {
		.step__body {
			font-size: 17px;
		}

		.demo {
			margin-top: 64px;
			padding: 32px;
			column-gap: 40px;
		}

		.rep__row {
			font-size: 15px;
			padding: 7px 0;
		}
	}
</style>
