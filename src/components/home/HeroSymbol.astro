---
/**
 * The ROBOSECT symbol: the R of the logo (the kit's negativo: Carta and rame chiaro), drawn as a stroke (not an outline)
 * so its appearance can be animated. At rest it is exactly the kit's symbol: the R ends in its crimped ferrule, same
 * geometry and colours, nothing redrawn or stretched. The name stays in the nav bar.
 * The opening (once, on load, motion only; pure CSS, so it plays even if the page script fails): the ferrule slides in,
 * then the cable runs out of its mouth along the R, its copper conductor leading, and stops at the stem foot, where the
 * test lead takes over on the first scroll (scripts/panel/hero.ts). Reduced motion, no JS, print: the symbol as it is.
 */
import { R_GEOMETRY as G } from '../../lib/cable-geometry';

const vbY = G.top - 0.5;
const vbH = G.bot - G.top + 1;
const F = G.ferrule;
// the symbol's box: the stem's left edge (x 0) to the strands' tip; one unit = --s px (set by the hero)
const vbW = F.x1;
// the conductor: as wide as the page lead's copper (0.43 of the cable), as long as its copper tip (1.35 cable widths)
const bw = +(G.w * 0.43).toFixed(2);
const size = `--sym-w:${vbW};--sym-ar:${vbW} / ${+vbH.toFixed(4)}`;
---

<svg class="hero-symbol" viewBox={`0 ${vbY} ${vbW} ${vbH}`} role="img" aria-label="ROBOSECT" data-wordmark focusable="false" style={size}>
	{/* paint as literal attributes: Carta cable and collar, rame chiaro copper; CSS sets only the opening's dashes */}
	<g class="hw-r">
		<path class="hw-cable" d={G.rD} pathLength="100" fill="none" stroke="#F4F1EC" stroke-width={G.w} stroke-linecap="butt" data-hw-r></path>
		<path class="hw-head" d={G.rD} pathLength="100" fill="none" stroke="#EC8A52" stroke-width={bw} stroke-linecap="butt" stroke-dasharray="0 1000" data-hw-head></path>
		<g class="hw-ferrule" data-hw-ferrule>
			<path d={F.collar} fill="#F4F1EC" stroke="none"></path>
			<path d={F.cu} fill="#EC8A52" stroke="none"></path>
		</g>
	</g>
	{/* the little fitting under the stem foot: the big cable goes in, the page lead comes out of its mouth (the lead starts SX units lower, Hero.astro). All three are in the HTML, one shows: html[data-sistemino] is set at random before the first paint (BaseLayout);; without it, the reducer */}
	<g class="sx" data-sx="giunto">
		<g class="sx-body">
		<path d="M-1.92 98.2A1.2 1.2 0 0 1-.72 97H12.72A1.2 1.2 0 0 1 13.92 98.2V100.4L9.4 103.8H2.6L-1.92 100.4Z" fill="#F4F1EC"/>
		</g>
		<rect class="sx-cu" x="3.9" y="103.8" width="4.2" height="2.2" fill="#EC8A52"/>
	</g>
	<g class="sx" data-sx="morsetto">
		<g class="sx-body">
		<rect x="-4" y="97" width="20" height="9" rx="2" fill="#F4F1EC" stroke="#BAC4D0" stroke-width=".3"/>
		<rect x="-.5" y="97" width="13" height="1.3" fill="#0D1B2E"/>
		<rect x="4.3" y="104.9" width="3.4" height="1.1" fill="#0D1B2E"/>
		</g>
		<g class="sx-screw"><circle cx="-1.1" cy="101.6" r="1.5" fill="#E9E5DE" stroke="#5A6676" stroke-width=".3"/><rect class="sx-slot" x="-2.1" y="101.35" width="2" height=".5" fill="#0D1B2E"/></g>
		<g class="sx-screw"><circle cx="13.1" cy="101.6" r="1.5" fill="#E9E5DE" stroke="#5A6676" stroke-width=".3"/><rect class="sx-slot" x="12.1" y="101.35" width="2" height=".5" fill="#0D1B2E"/></g>
		<circle class="sx-body" cx="6" cy="101.6" r="1.15" fill="#E9E5DE" stroke="#9AA6B5" stroke-width=".3"/>
		<g class="sx-on"><g class="sx-glow"><circle cx="6" cy="101.6" r="2.99" fill="#EC8A52" fill-opacity=".12"/><circle cx="6" cy="101.6" r="1.95" fill="#EC8A52" fill-opacity=".22"/></g><circle cx="6" cy="101.6" r="1.15" fill="#EC8A52"/></g>
	</g>
	<g class="sx" data-sx="spina">
		<g class="sx-body">
		<path d="M-1.92 98.2A1.2 1.2 0 0 1-.72 97H12.72A1.2 1.2 0 0 1 13.92 98.2V100.9H-1.92Z" fill="#F4F1EC"/>
		</g>
		<g class="sx-plug">
		<rect x="2.7" y="100" width="1.2" height="1.4" fill="#EC8A52"/>
		<rect x="8.1" y="100" width="1.2" height="1.4" fill="#EC8A52"/>
		<path d="M1 101.3H11V104.2A1.8 1.8 0 0 1 9.2 106H2.8A1.8 1.8 0 0 1 1 104.2Z" fill="#172A44" stroke="#9AA6B5" stroke-width=".35"/>
		<circle cx="6" cy="103.5" r=".9" fill="none" stroke="#9AA6B5" stroke-width=".3"/>
		<g class="sx-on"><g class="sx-glow"><circle cx="6" cy="103.5" r="2.34" fill="#EC8A52" fill-opacity=".12"/><circle cx="6" cy="103.5" r="1.53" fill="#EC8A52" fill-opacity=".22"/></g><circle cx="6" cy="103.5" r=".9" fill="#EC8A52"/></g>
		</g>
	</g>
</svg>

<style>
	.hero-symbol {
		/* one unit of the logo grid = var(--s) px (set by the hero) */
		width: calc(var(--s) * var(--sym-w));
		height: auto;
		aspect-ratio: var(--sym-ar);
		overflow: visible;
	}

	/* The opening, ≈ 1.2 s. The cable's dashes run in pathLength units (the R = 100): the conductor's front C goes
	   0 → 106.5 from the ferrule's mouth to the stem foot and out of it; the copper (6.5 long) is [C − 6.5, C], the white
	   insulation [0, C − 6.5] behind it. Nothing shows at the start; at the end the white covers the whole R and the copper
	   has run out of the path at the foot: the kit's symbol again. html.motion is set before
	   the first paint (BaseLayout), so the R never flashes whole first; the page script marks it done
	   (data-intro-done) so a later switch back to motion (print, the reduced-motion setting) does not replay it. */
	:global(html.motion) .hero-symbol:not([data-intro-done]) .hw-cable {
		stroke-dasharray: 100 200;
		animation: hw-lay 860ms cubic-bezier(0.65, 0, 0.35, 1) 300ms both;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) .hw-head {
		stroke-dasharray: 6.5 300;
		animation: hw-cu 860ms cubic-bezier(0.65, 0, 0.35, 1) 300ms both;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) .hw-ferrule {
		animation: hw-crimp 460ms cubic-bezier(0.22, 1, 0.36, 1) 0ms both;
	}

	@keyframes hw-lay {
		from {
			stroke-dashoffset: 106.5;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes hw-cu {
		from {
			stroke-dashoffset: 6.5;
		}
		to {
			stroke-dashoffset: -100;
		}
	}

	/* the ferrule is crimped: it appears a little open (taller) and the press closes it, in place (it never leaves the
	   symbol's box, so nothing crosses the page margin) */
	:global(html.motion) .hw-ferrule {
		transform-box: fill-box;
		transform-origin: 30% 50%;
	}

	@keyframes hw-crimp {
		from {
			opacity: 0;
			transform: scaleY(1.22);
		}
		45% {
			opacity: 1;
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	/* The fitting enters only when the R is whole (the R ends at 1160 ms; every sx delay starts there), then the lead comes out
	   of its mouth (hero.ts holds the lead back until the last animation ends). The fitting under the foot (10 units tall; the svg's box does not grow, it overflows). One of three is shown, chosen at
	   random per load (BaseLayout sets html[data-sistemino]); the reducer is the default (no JS). Same opening rules as
	   the R: only in motion, once. */
	.sx {
		display: none;
	}

	.sx[data-sx='giunto'] {
		display: inline;
	}

	:global(html[data-sistemino='morsetto']) .sx[data-sx='giunto'],
	:global(html[data-sistemino='spina']) .sx[data-sx='giunto'] {
		display: none;
	}

	:global(html[data-sistemino='morsetto']) .sx[data-sx='morsetto'],
	:global(html[data-sistemino='spina']) .sx[data-sx='spina'] {
		display: inline;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) .sx :is(.sx-body, .sx-cu, .sx-slot) {
		transform-box: fill-box;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) [data-sx='giunto'] .sx-body,
	:global(html.motion) .hero-symbol:not([data-intro-done]) [data-sx='spina'] .sx-body {
		transform-origin: 50% 0;
		animation: sx-crimp 460ms cubic-bezier(0.22, 1, 0.36, 1) 1160ms both;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) [data-sx='giunto'] .sx-cu {
		transform-origin: 50% 0;
		animation: sx-fill 220ms cubic-bezier(0.65, 0, 0.35, 1) 1760ms both;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) [data-sx='morsetto'] :is(.sx-body, .sx-screw) {
		animation: sx-fade 380ms ease-out 1160ms both;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) [data-sx='morsetto'] .sx-slot {
		transform-origin: 50% 50%;
		animation: sx-turn 260ms cubic-bezier(0.22, 1, 0.36, 1) 1610ms both;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) [data-sx='morsetto'] .sx-on,
	:global(html.motion) .hero-symbol:not([data-intro-done]) [data-sx='spina'] .sx-on {
		animation: sx-fade 200ms ease-out 1810ms both;
	}

	:global(html.motion) .hero-symbol:not([data-intro-done]) [data-sx='spina'] .sx-plug {
		animation: sx-plug 420ms cubic-bezier(0.22, 1, 0.36, 1) 1460ms both;
	}

	@keyframes sx-crimp {
		from { opacity: 0; transform: scaleX(1.22); }
		45% { opacity: 1; }
		to { opacity: 1; transform: none; }
	}
	@keyframes sx-fill {
		from { transform: scaleY(0); }
		to { transform: none; }
	}
	@keyframes sx-fade {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	@keyframes sx-turn {
		from { transform: rotate(-55deg); }
		to { transform: none; }
	}
	@keyframes sx-plug {
		from { opacity: 0; transform: translateY(3.5px); }
		40% { opacity: 1; }
		to { opacity: 1; transform: none; }
	}
</style>
