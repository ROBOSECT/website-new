---
import { Image, getImage } from 'astro:assets';
import imgTool from '../../assets/images/home/tech-endeffector.jpg';
import posterSrc from '../../assets/images/home/video-poster.jpg';
import videoSrc from '../../assets/videos/robosect_v4.mp4';
import Rich from '../ui/Rich.astro';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].technology;
const poster = await getImage({ src: posterSrc, width: 1280, height: 720, format: 'jpg', quality: 78 });
const toolAlt = {
	en: 'A red custom probe end-effector mounted on the wrist of a collaborative robot, with its probe tip pointing down',
	it: 'Un end-effector rosso a puntale, progettato su misura, montato sul polso di un robot collaborativo, con il puntale rivolto in basso',
}[lang];
// the legend must fit above the robot cell (MOTION-SPEC v4 §1.5): the body splits at a sentence boundary,
// the first two sentences stay in the legend and the rest opens the module (copy unchanged)
const sentences = t.body.split(/(?<=\.)\s+/);
const legendIntro = sentences.slice(0, 2).join(' ');
const bodyRest = sentences.slice(2).join(' ');
---

<Compartment n={4} lang={lang} id={t.id} name={t.eyebrow} title={t.title} intro={legendIntro} ground="light">
	<div class="tech">
		<div class="tech__text">
			<p class="tech__lead" data-b>{bodyRest}</p>
			<ul class="tech__pillars">
				{
					t.pillars.map((p) => (
						<li data-b>
							<h3>{p.title}</h3>
							<p>{p.body}</p>
						</li>
					))
				}
			</ul>
		</div>
		<figure class="tech__photo" data-b>
			<div class="tech__frame">
				<Image src={imgTool} alt={toolAlt} widths={[320, 480, 640, 800]} sizes="(min-width: 1100px) 400px, (min-width: 700px) 40vw, 100vw" loading="lazy" />
			</div>
			<figcaption>{t.photo.caption}</figcaption>
		</figure>
	</div>

	<div id={t.video.id} class="tvid">
		<div class="tvid__head" data-b>
			<h3 class="tvid__title">{t.video.title}</h3>
			<p class="tvid__desc" id="video-desc">{t.video.description}</p>
		</div>
		<figure class="tvid__frame" data-b>
			<video class="tvid__el" width="1920" height="1080" controls muted playsinline preload="none" poster={poster.src} aria-describedby="video-desc">
				<source src={videoSrc} type="video/mp4" />
			</video>
			{/* print: the poster in the video's place (review 3, ENG-11: a video prints as an empty box) */}
			<img class="tvid__print" src={poster.src} width="1280" height="720" alt="" aria-hidden="true" loading="lazy" decoding="async" />
			<figcaption class="tvid__cap"><Rich text={t.video.caption} /></figcaption>
		</figure>
	</div>
</Compartment>

<style>
	.tvid__print {
		display: none;
	}

	@media print {
		.tvid__el {
			display: none !important;
		}

		.tvid__print {
			display: block;
			width: 100%;
			height: auto;
		}
	}

	.tech {
		display: grid;
		gap: 40px;
	}

	.tech__lead {
		font-size: 17px;
		line-height: 1.5;
		letter-spacing: -0.005em;
		max-width: 34em;
	}

	.tech__pillars {
		list-style: none;
		display: grid;
		gap: 24px;
		margin-top: 36px;
	}

	.tech__pillars li {
		padding-left: 20px;
		border-left: 4px solid var(--blue);
	}

	.tech__pillars h3 {
		font-size: 20px;
		line-height: 1.25;
	}

	.tech__pillars p {
		margin-top: 6px;
		font-size: 17px;
		line-height: 1.55;
		max-width: 48ch;
	}

	.tech__frame {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
	}

	.tech__frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
	}

	.tech__photo figcaption,
	.tvid__cap {
		margin-top: 12px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--steel);
		max-width: 46ch;
	}

	.tvid {
		margin-top: 64px;
	}

	.tvid__title {
		font-size: 24px;
		line-height: 1.15;
		letter-spacing: -0.02em;
		max-width: 18em;
	}

	.tvid__desc {
		margin-top: 10px;
		font-size: 17px;
		line-height: 1.5;
		max-width: 46em;
	}

	.tvid__frame {
		margin-top: 24px;
	}

	.tvid__el {
		width: 100%;
		aspect-ratio: 16 / 9;
		background: var(--ink);
		border-radius: 0 0 0 var(--bend);
	}

	.tvid__cap {
		max-width: 80ch;
	}

	@media (min-width: 1100px) {
		.tech {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gap);
			align-items: start;
		}

		.tech__text {
			grid-column: 1 / span 7;
		}

		.tech__photo {
			grid-column: 9 / -1;
		}

		.tech__frame {
			aspect-ratio: 4 / 5;
		}

		.tech__lead {
			font-size: 20px;
		}

		.tech__pillars {
			margin-top: 44px;
			gap: 28px;
		}

		.tvid {
			margin-top: 96px;
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gap);
		}

		.tvid__head {
			grid-column: 1 / span 4;
		}

		.tvid__title {
			font-size: 32px;
		}

		.tvid__frame {
			grid-column: 5 / -1;
			margin-top: 0;
		}
	}
</style>
