---
/**
 * What you get: four outcomes for a switchboard builder. The figures behind them are not measured yet, so the cards
 * show none (no placeholders on the page); they come back with their test conditions once measured.
 * (+C3's vignette: the opener opens the spring cage, the lead goes in, four outputs light 1 → 4: the four outcomes.)
 */
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';
import ProductCards from './ProductCards.astro';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const b = copy[lang].benefits;
const cta = copy[lang].cta;
---

<Compartment n={3} lang={lang} id={b.id} name={b.eyebrow} title={b.title} intro={b.intro} ground="dark">
	<ul class="gets">
		{
			b.items.map((it, i) => (
				<li class="get" data-b>
					<p class="get__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
					<h3 class="get__title">{it.title}</h3>
					<p class="get__body">{it.body}</p>
				</li>
			))
		}
	</ul>
	<div class="prods" id={b.products.id} data-b>
		<h3 class="prods__h">{b.products.title}</h3>
		<p class="prods__intro">{b.products.intro}</p>
		<ProductCards lang={lang} forLabel={b.products.forLabel} cards={b.products.cards} dark />
	</div>
	<p class="gets__cta" data-b>
		<a class="btn" href="#contact">
			{cta.label}
			<svg class="btn__arrow" viewBox="0 0 18 18" aria-hidden="true"
				><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg
			>
		</a>
		<span class="gets__promise">{b.ctaPromise}</span>
	</p>
</Compartment>

<style>
	.prods {
		margin-top: 56px;
	}

	.prods__h {
		font-size: 24px;
		line-height: 1.2;
		color: var(--paper);
	}

	.prods__intro {
		margin-top: 8px;
		font-size: 16px;
		line-height: 1.5;
		color: var(--steel-light);
		max-width: 46em;
	}

	@media (min-width: 1100px) {
		.prods {
			margin-top: 80px;
		}
	}

	.gets {
		list-style: none;
		display: grid;
		gap: 8px;
	}

	.get {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 20px;
		background: var(--ink-2);
	}

	.get__n {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: var(--steel-light);
	}

	.get__title {
		margin-top: 8px;
		font-size: 21px;
		line-height: 1.2;
		color: var(--paper);
	}

	.get__body {
		margin-top: 10px;
		font-size: 16px;
		line-height: 1.55;
		color: var(--paper);
	}


	.gets__cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 24px;
		margin-top: 40px;
	}

	.gets__promise {
		max-width: 30em;
		font-size: 16px;
		line-height: 1.45;
		color: var(--paper);
	}

	@media (max-width: 699px) {
		.gets__cta .btn {
			width: 100%;
		}
	}

	@media (min-width: 700px) {
		.gets {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.get {
			padding: 24px;
		}
	}

	@media (min-width: 1100px) {
		.gets {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.get__title {
			font-size: 22px;
		}

		.gets__cta {
			margin-top: 56px;
		}
	}
</style>
