---
/**
 * What you get: four outcomes for a switchboard builder. The figures behind them are not measured yet: each one is a
 * visible [TBD] placeholder, and the note says they will come with their test conditions.
 * (+C3's vignette: the opener opens the spring cage, the lead goes in, four outputs light 1 → 4: the four outcomes.)
 */
import Rich from '../ui/Rich.astro';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';
import { pagePath } from '../../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const b = copy[lang].benefits;
const cta = copy[lang].cta;
---

<Compartment n={3} lang={lang} id={b.id} name={b.eyebrow} title={b.title} intro={b.intro} ground="dark">
	<ul class="gets">
		{
			b.items.map((it, i) => (
				<li class="get" data-b>
					<p class="get__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
					<h3 class="get__title">{it.title}</h3>
					<p class="get__body">{it.body}</p>
					<p class="get__metric">
						<span class="get__label">{it.valueLabel}</span>
						<span class="get__value">
							<Rich text={it.value} />
						</span>
					</p>
				</li>
			))
		}
	</ul>
	<p class="gets__note" data-b><Rich text={b.note} /></p>
	<div class="prods" id={b.products.id} data-b>
		<h3 class="prods__h">{b.products.title}</h3>
		<p class="prods__intro">{b.products.intro}</p>
		<ol class="prods__list">
			{
				b.products.items.map((it, i) => (
					<li class={`prod prod--${i + 1}`}>
						<p class="prod__step"><span class="visually-hidden">{b.products.stepLabel} </span>{i + 1} · {it.status}</p>
						<h4 class="prod__name">{it.name}</h4>
						<p class="prod__body">{it.body}</p>
						{it.cta ? (
							<a class="text-link" href="#contact">
								{it.cta}
								<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
							</a>
						) : null}
					</li>
				))
			}
		</ol>
		<p class="prods__more">
			<a class="text-link" href={pagePath(lang, 'products')}>
				{b.products.more}
				<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
			</a>
		</p>
	</div>
	<p class="gets__cta" data-b>
		<a class="btn" href="#contact">
			{cta.label}
			<svg class="btn__arrow" viewBox="0 0 18 18" aria-hidden="true"
				><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg
			>
		</a>
		<span class="gets__promise">{cta.promise}</span>
	</p>
</Compartment>

<style>
	.prods {
		margin-top: 56px;
	}

	.prods__h {
		font-size: 24px;
		line-height: 1.2;
		color: var(--paper);
	}

	.prods__intro {
		margin-top: 8px;
		font-size: 16px;
		line-height: 1.5;
		color: var(--steel-light);
		max-width: 46em;
	}

	.prods__more {
		margin-top: 24px;
	}

	.prods__list {
		list-style: none;
		display: grid;
		gap: 8px;
		margin-top: 24px;
	}

	.prod {
		padding: 20px;
		background: var(--ink-2);
		border-left: 4px solid var(--blue);
	}

	.prod--2 {
		margin-left: 16px;
	}

	.prod--3 {
		margin-left: 32px;
	}

	.prod__step {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--steel-light);
	}

	.prod__name {
		margin-top: 6px;
		font-size: 21px;
		line-height: 1.2;
		color: var(--paper);
	}

	.prod__body {
		margin: 8px 0 12px;
		font-size: 16px;
		line-height: 1.5;
		color: var(--paper);
		max-width: 46em;
	}

	.prod__body:last-child {
		margin-bottom: 0;
	}

	@media (min-width: 1100px) {
		.prods {
			margin-top: 80px;
		}

		.prods__list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			align-items: start;
			gap: 8px;
		}

		/* a staircase going up: the entry product lowest */
		.prod--1 {
			margin-top: 56px;
		}

		.prod--2 {
			margin-left: 0;
			margin-top: 28px;
		}

		.prod--3 {
			margin-left: 0;
		}
	}

	.gets {
		list-style: none;
		display: grid;
		gap: 8px;
	}

	.get {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 20px;
		background: var(--ink-2);
	}

	.get__n {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: var(--steel-light);
	}

	.get__title {
		margin-top: 8px;
		font-size: 21px;
		line-height: 1.2;
		color: var(--paper);
	}

	.get__body {
		margin-top: 10px;
		font-size: 16px;
		line-height: 1.55;
		color: var(--paper);
	}

	/* the measured figure: a label and its value, at the foot of the card */
	.get__metric {
		display: grid;
		gap: 6px;
		margin-top: auto;
		padding-top: 20px;
	}

	.get__label {
		padding-top: 12px;
		border-top: 1px solid #2b3a52;
		font-size: 13.5px;
		line-height: 1.35;
		color: var(--steel-light);
	}

	.gets__note {
		margin-top: 16px;
		font-size: 15px;
		line-height: 1.5;
		color: var(--steel-light);
	}

	.gets__cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 24px;
		margin-top: 40px;
	}

	.gets__promise {
		max-width: 30em;
		font-size: 16px;
		line-height: 1.45;
		color: var(--paper);
	}

	@media (max-width: 699px) {
		.gets__cta .btn {
			width: 100%;
		}
	}

	@media (min-width: 700px) {
		.gets {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.get {
			padding: 24px;
		}
	}

	@media (min-width: 1100px) {
		.gets {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.get__title {
			font-size: 22px;
		}

		.gets__cta {
			margin-top: 56px;
		}
	}
</style>
