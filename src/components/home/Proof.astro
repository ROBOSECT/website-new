---
/**
 * Proof, before any claim: the prototype video first (#video, opened from the hero too), the probe end-effector, then the
 * three verified facts (University of Bologna spin-off, AIRISE.eu funding, IEEE/ASME AIM 2026) and the latest news.
 * Maturity is said plainly: a working prototype.
 * (+C4's vignette: two arms, two probes on the two ends of one wire: the continuity test the prototype does.)
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import imgTool from '../../assets/images/home/tech-endeffector.jpg';
import posterSrc from '../../assets/images/home/video-poster.jpg';
import videoSrc from '../../assets/videos/robosect_v4.mp4';
import logoUnibo from '../../assets/images/logo_unibo.png';
import logoAirise from '../../assets/images/home/logo-airise.png';
import Rich from '../ui/Rich.astro';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const p = copy[lang].proof;
const b = copy[lang].blog;
const poster = await getImage({ src: posterSrc, width: 1280, height: 720, format: 'jpg', quality: 78 });
const logos = [
	{ src: logoUnibo, h: 52 },
	{ src: logoAirise, h: 22 },
	null,
];
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((x, y) => y.data.date.valueOf() - x.data.date.valueOf()).slice(0, 2);
const fmt = (d: Date) => d.toLocaleDateString(copy[lang].meta.dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
---

<Compartment n={4} lang={lang} id={p.id} name={p.eyebrow} title={p.title} intro={p.intro} ground="light">
	<div id={p.video.id} class="tvid">
		<div class="tvid__head" data-b>
			<p class="tvid__status">{p.status}</p>
			<h3 class="tvid__title">{p.video.title}</h3>
			<p class="tvid__desc" id="video-desc">{p.video.description}</p>
		</div>
		<figure class="tvid__frame" data-b>
			<video class="tvid__el" width="1920" height="1080" controls muted playsinline preload="none" poster={poster.src} aria-describedby="video-desc">
				<source src={videoSrc} type="video/mp4" />
			</video>
			{/* print: the poster in the video's place (a video prints as an empty box) */}
			<img class="tvid__print" src={poster.src} width="1280" height="720" alt="" aria-hidden="true" loading="lazy" decoding="async" />
			<figcaption class="tvid__cap"><Rich text={p.video.caption} /></figcaption>
		</figure>
	</div>

	<div class="facts">
		<figure class="tool" data-b>
			<div class="tool__frame">
				<Image src={imgTool} alt={p.photo.alt} widths={[320, 480, 640]} sizes="(min-width: 1100px) 340px, (min-width: 700px) 40vw, 100vw" loading="lazy" />
			</div>
			<figcaption>{p.photo.caption}</figcaption>
		</figure>
		<div class="who" data-b>
			<h3 class="who__h">{p.factsTitle}</h3>
			<ul class="who__list">
				{
					p.facts.map((f, i) => (
						<li class="who__row">
							<div class="who__logo">
								{logos[i] ? (
									<Image src={logos[i]!.src} alt={f.logoAlt} height={logos[i]!.h * 2} style={`height:${logos[i]!.h}px`} loading="lazy" />
								) : (
									<span class="who__mark" aria-hidden="true">AIM 2026</span>
								)}
							</div>
							<div>
								<p class="who__name">{f.name}</p>
								<p class="who__detail">
									<Rich text={f.detail} />
								</p>
							</div>
						</li>
					))
				}
			</ul>
			<div class="news">
				<p class="news__h">{b.homeTeaserTitle}</p>
				<ul class="news__list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}`} hreflang="en">
									<span class="news__date">{fmt(post.data.date)}</span>
									<span class="news__title">{post.data.title}</span>
								</a>
							</li>
						))
					}
				</ul>
				{b.languageNote && <p class="news__note">{b.languageNote}</p>}
			</div>
		</div>
	</div>
</Compartment>

<style>
	.tvid__print {
		display: none;
	}

	@media print {
		.tvid__el {
			display: none !important;
		}

		.tvid__print {
			display: block;
			width: 100%;
			height: auto;
		}
	}

	.tvid {
		display: grid;
		gap: 20px;
	}

	.tvid__status {
		display: inline-block;
		padding: 4px 10px;
		background: var(--white);
		border-left: 4px solid var(--blue);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--blue);
	}

	.tvid__title {
		margin-top: 14px;
		font-size: 24px;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.tvid__desc {
		margin-top: 10px;
		font-size: 16px;
		line-height: 1.5;
		max-width: 46em;
	}

	.tvid__el {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: var(--ink);
		border-radius: 0 0 0 var(--bend);
	}

	.tvid__cap,
	.tool figcaption {
		margin-top: 12px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--steel);
		max-width: 80ch;
	}

	.facts {
		display: grid;
		gap: 40px;
		margin-top: 56px;
	}

	.tool__frame {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
	}

	.tool__frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
	}

	.who__h {
		font-size: 24px;
		line-height: 1.2;
	}

	.who__list {
		list-style: none;
		display: grid;
		gap: 4px;
		margin-top: 20px;
	}

	.who__row {
		display: grid;
		gap: 10px;
		padding: 16px;
		background: var(--white);
	}

	.who__logo {
		display: flex;
		align-items: center;
	}

	.who__logo :global(img) {
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	.who__mark {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--blue);
	}

	.who__name {
		font-size: 17px;
		font-weight: 600;
		line-height: 1.3;
	}

	.who__detail {
		margin-top: 4px;
		font-size: 15px;
		line-height: 1.45;
	}

	.news {
		margin-top: 32px;
	}

	.news__h {
		font-size: 15px;
		font-weight: 600;
		color: var(--steel);
	}

	.news__list {
		list-style: none;
		display: grid;
		gap: 4px;
		margin-top: 10px;
	}

	.news__list a {
		display: grid;
		gap: 2px;
		padding: 12px 16px;
		background: var(--white);
		color: var(--ink);
		text-decoration: none;
		transition: background-color 0.18s var(--ease-out);
	}

	.news__list a:hover {
		background: var(--mist);
	}

	.news__date {
		font-size: 14px;
		color: var(--steel);
	}

	.news__title {
		font-size: 16px;
		font-weight: 600;
		line-height: 1.3;
	}

	.news__note {
		margin-top: 6px;
		font-size: 14px;
		color: var(--steel);
	}

	@media (min-width: 700px) {
		.who__row {
			grid-template-columns: 150px minmax(0, 1fr);
			gap: 18px;
			align-items: center;
		}

		.facts {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			column-gap: var(--gap);
			align-items: start;
		}
	}

	@media (min-width: 1100px) {
		.tvid {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gap);
			align-items: start;
		}

		.tvid__head {
			grid-column: 1 / span 4;
		}

		.tvid__title {
			font-size: 32px;
		}

		.tvid__frame {
			grid-column: 5 / -1;
		}

		.facts {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			margin-top: 80px;
		}

		.tool {
			grid-column: 1 / span 4;
		}

		.who {
			grid-column: 6 / -1;
		}
	}
</style>
