---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logoUnibo from '../../assets/images/logo_unibo.png';
import logoAirise from '../../assets/images/home/logo-airise.png';
import logoEit from '../../assets/images/logo_EIT.png';
import logoCobo from '../../assets/images/logo_cobo.png';
import Rich from '../ui/Rich.astro';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const p = copy[lang].proof;
const b = copy[lang].blog;

const logos = [
	{ src: logoUnibo, h: 52 },
	{ src: logoAirise, h: 22 },
	{ src: logoEit, h: 44 },
	{ src: logoCobo, h: 28 },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((x, y) => y.data.date.valueOf() - x.data.date.valueOf()).slice(0, 2);
const fmt = (d: Date) => d.toLocaleDateString(copy[lang].meta.dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
---

<Compartment n={5} lang={lang} id={p.id} name={p.eyebrow} title={p.title} intro={p.intro} ground="light">
	<ul class="metrics">
		{
			p.metrics.map((m) => (
				<li class="metric" data-b>
					<p class="metric__label">{m.label}</p>
					<p class="metric__value">
						<Rich text={m.value} />
					</p>
				</li>
			))
		}
	</ul>
	<p class="metrics__note" data-b><Rich text={p.metricsNote} /></p>

	<div class="facts">
		<div class="eco" data-b>
			<h3>{p.programmesTitle}</h3>
			<ul class="eco__list">
				{
					p.programmes.map((g, i) => (
						<li class="eco__row">
							<div class="eco__logo">
								<Image src={logos[i].src} alt={g.logoAlt} height={logos[i].h * 2} style={`height:${logos[i].h}px`} loading="lazy" />
							</div>
							<p>
								<Rich text={g.role} />
							</p>
						</li>
					))
				}
			</ul>
		</div>
		<div class="side">
			<div class="events" data-b>
				<h3>{p.eventsTitle}</h3>
				{
					p.events.map((e) => (
						<p class="event">
							<span class="event__name">{e.name}</span>
							<span class="event__detail">{e.detail}</span>
						</p>
					))
				}
			</div>
			<div class="news" data-b>
				<h3>{b.homeTeaserTitle}</h3>
				<ul class="news__list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}`} hreflang="en">
									<span class="news__date">{fmt(post.data.date)}</span>
									<span class="news__title">{post.data.title}</span>
								</a>
							</li>
						))
					}
				</ul>
				<a class="text-link" href="/blog">
					{b.viewAll}
					<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
				</a>
				{b.languageNote && <p class="news__note">{b.languageNote}</p>}
			</div>
		</div>
	</div>
</Compartment>

<style>
	.metrics {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
	}

	.metric {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 18px;
		min-height: 150px;
		padding: 18px 16px;
		background: var(--white);
	}

	.metric__label {
		font-size: 15px;
		font-weight: 500;
		line-height: 1.35;
	}

	.metric__value :global(.tbd) {
		font-size: 13px;
	}

	.metrics__note {
		margin-top: 14px;
		font-size: 15px;
		color: var(--steel);
	}

	.facts {
		display: grid;
		gap: 48px;
		margin-top: 56px;
	}

	.facts h3 {
		font-size: 24px;
		line-height: 1.2;
	}

	.eco__list {
		list-style: none;
		display: grid;
		gap: 4px;
		margin-top: 20px;
	}

	.eco__row {
		display: grid;
		grid-template-columns: 112px minmax(0, 1fr);
		gap: 20px;
		align-items: center;
		padding: 16px;
		background: var(--white);
	}

	.eco__logo {
		display: flex;
		align-items: center;
	}

	.eco__logo :global(img) {
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	.eco__row p {
		font-size: 15px;
		line-height: 1.45;
	}

	.side {
		display: grid;
		gap: 44px;
		align-content: start;
	}

	.event {
		display: grid;
		gap: 2px;
		margin-top: 16px;
	}

	.event__name {
		font-size: 20px;
		font-weight: 600;
	}

	.event__detail {
		font-size: 17px;
	}

	.news__list {
		list-style: none;
		display: grid;
		gap: 4px;
		margin: 16px 0 12px;
	}

	.news__list a {
		display: grid;
		gap: 4px;
		padding: 14px 16px;
		background: var(--white);
		color: var(--ink);
		text-decoration: none;
		transition: background-color 0.18s var(--ease-out);
	}

	.news__list a:hover {
		background: var(--mist);
	}

	.news__date {
		font-size: 15px;
		color: var(--steel);
	}

	.news__title {
		font-size: 17px;
		font-weight: 600;
		line-height: 1.3;
	}

	.news__note {
		margin-top: 6px;
		font-size: 15px;
		color: var(--steel);
	}

	@media (min-width: 700px) {
		.metric {
			min-height: 168px;
			padding: 22px 20px;
		}

		.eco__row {
			grid-template-columns: 150px minmax(0, 1fr);
		}
	}

	@media (min-width: 1100px) {
		.metrics {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.facts {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gap);
			margin-top: 72px;
		}

		.eco {
			grid-column: 1 / span 7;
		}

		.side {
			grid-column: 9 / -1;
		}
	}
</style>
