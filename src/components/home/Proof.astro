---
/**
 * The prototype, on the «How it works» page: the video first (#video: it starts on its own, muted and in a loop, when it
 * is on screen; scripts/home.ts), with one line under its title; then the two arms on one terminal block (a still with
 * its short loop) beside what changes in a switchboard builder's testing; then the way back (Back to solutions) and the
 * way in (Write to us, to the form at the foot of this page). Maturity is said plainly: a working prototype.
 * Who stands behind it is on the home page, in the Team, in one line each (strada A, 19/11/2026).
 * (+C4's vignette: two arms, two probes on the two ends of one wire: the continuity test the prototype does.)
 */
import { Image, getImage } from 'astro:assets';
import imgTool from '../../assets/images/home/demo-two-probes.jpg';
import posterSrc from '../../assets/images/home/demo-poster.jpg';
import videoSrc from '../../assets/videos/robosect_v4.mp4';
import loopMp4 from '../../assets/videos/two-arms-loop.mp4';
import loopWebm from '../../assets/videos/two-arms-loop.webm';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';
import { homePath } from '../../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const p = copy[lang].proof;
const ch = copy[lang].changes;
const hp = copy[lang].howPage;
const sol = copy[lang].solutions;
const poster = await getImage({ src: posterSrc, width: 1280, height: 720, format: 'jpg', quality: 78 });
---

<Compartment n={4} lang={lang} id={p.id} name={p.eyebrow} title={p.title} intro={p.intro} ground="light">
	<div id={p.video.id} class="tvid">
		<div class="tvid__head" data-b>
			<p class="tvid__status">{p.status}</p>
			<h3 class="tvid__title">{p.video.title}</h3>
			<p class="tvid__desc" id="video-desc">{p.video.description}</p>
		</div>
		<figure class="tvid__frame" data-b>
			<video class="tvid__el" width="1920" height="1080" controls muted loop playsinline preload="none" poster={poster.src} aria-describedby="video-desc" data-autoplay>
				<source src={videoSrc} type="video/mp4" />
			</video>
			{/* print: the poster in the video's place (a video prints as an empty box) */}
			<img class="tvid__print" src={poster.src} width="1280" height="720" alt="" aria-hidden="true" loading="lazy" decoding="async" />
		</figure>
	</div>

	<div class="more">
		<figure class="tool" data-b>
			<div class="tool__frame">
				<Image src={imgTool} alt={p.photo.alt} widths={[320, 480, 760]} sizes="(min-width: 1100px) 440px, (min-width: 700px) 40vw, 100vw" loading="lazy" />
				{/* a 5 s muted loop of the same moment, over the still: it starts from home.ts (not with reduced motion or data saver; without JS the still stays) */}
				<video class="tool__loop" width="800" height="600" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-loop>
					<source src={loopWebm} type="video/webm" />
					<source src={loopMp4} type="video/mp4" />
				</video>
			</div>
			<figcaption>{p.photo.caption}</figcaption>
		</figure>
		<div class="chg" data-b>
			<h3 class="chg__h">{ch.title}</h3>
			<ul class="chg__list">
				{
					ch.items.map((it) => (
						<li class="chg__item">
							<p class="chg__t">{it.title}</p>
							<p class="chg__b">{it.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<p class="back" data-b>
		<a class="btn" href="#contact">
			{hp.write}
			<svg class="btn__arrow" viewBox="0 0 18 18" aria-hidden="true"
				><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg
			>
		</a>
		<a class="text-link" href={`${homePath(lang)}#${sol.id}`}>
			<svg class="back__arrow" viewBox="0 0 18 18" aria-hidden="true"><path d="M16 9H4M8.5 4.5 4 9l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
			{hp.back}
		</a>
	</p>
</Compartment>

<style>
	.tvid__print {
		display: none;
	}

	@media print {
		.tvid__el {
			display: none !important;
		}

		.tvid__print {
			display: block;
			width: 100%;
			height: auto;
		}
	}

	.tvid {
		display: grid;
		gap: 20px;
	}

	.tvid__status {
		display: inline-block;
		padding: 4px 10px;
		background: var(--white);
		border: 1px solid var(--blue);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--blue);
	}

	.tvid__title {
		margin-top: 14px;
		font-size: 24px;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.tvid__desc {
		margin-top: 10px;
		font-size: 16px;
		line-height: 1.5;
		max-width: 46em;
	}

	.tvid__el {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: var(--ink);
		border-radius: 0 0 0 var(--bend);
	}

	.tool figcaption {
		margin-top: 12px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--steel);
		max-width: 80ch;
	}

	.tool__frame {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
	}

	.tool__frame {
		position: relative;
	}

	.tool__loop {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.4s;
	}

	.tool__loop.is-on {
		opacity: 1;
	}

	@media print {
		.tool__loop {
			display: none;
		}
	}

	.tool__frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
	}


	.more {
		display: grid;
		gap: 40px;
		margin-top: 56px;
	}

	.chg__h {
		font-size: 24px;
		line-height: 1.2;
	}

	.chg__list {
		list-style: none;
		display: grid;
		gap: 18px;
		margin-top: 20px;
	}

	.chg__item {
		padding-top: 12px;
		border-top: 4px solid var(--blue);
	}

	.chg__t {
		font-size: 18px;
		font-weight: 600;
		line-height: 1.3;
	}

	.chg__b {
		margin-top: 6px;
		font-size: 16px;
		line-height: 1.5;
	}

	.back {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px 32px;
		margin-top: 48px;
	}

	.back .text-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.back__arrow {
		width: 18px;
		height: 18px;
	}

	@media (max-width: 699px) {
		.back .btn {
			width: 100%;
		}
	}

	@media (min-width: 700px) {
		.more {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			column-gap: var(--gap);
			align-items: start;
		}

		.chg__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 24px var(--gap);
		}
	}

	@media (min-width: 1100px) {
		.tvid {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gap);
			align-items: start;
		}

		.tvid__head {
			grid-column: 1 / span 4;
		}

		.tvid__title {
			font-size: 32px;
		}

		.tvid__frame {
			grid-column: 5 / -1;
		}

		.more {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			margin-top: 80px;
		}

		.tool {
			grid-column: 1 / span 5;
		}

		.chg {
			grid-column: 7 / -1;
		}

		.chg__h {
			font-size: 28px;
		}

		.back {
			margin-top: 64px;
		}
	}
</style>
