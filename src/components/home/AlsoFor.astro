---
/**
 * Also for you: everyone who does not build switchboards, in three short cards, a title and one line each (Giorgio,
 * 19/11/2026: fewer words). Wiring harnesses; robot cells and integrators (invited to work with us); engineering and R&D
 * for hire (#work, the bar's «Engineering & R&D»).
 * (+C5's vignette: the camera reads the lead's wire marker and checks it against the connection list.)
 */
import { Image } from 'astro:assets';
// the three photos in the brand duotone, ink -> blue -> paper, already treated and cut 16:9 (tools/duotono.py; Alex's
// choice C, 18/11/2026)
import duoHarness from '../../assets/images/home/duo-harness.jpg';
import duoCell from '../../assets/images/home/duo-cell.jpg';
import duoOther from '../../assets/images/home/duo-other.jpg';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const a = copy[lang].alsoFor;
const L = {
	en: {
		harness: 'Wires and terminal blocks inside an electrical panel',
		cell: 'The arm of a collaborative robot with its black cables strapped along it, over a switchboard',
		other: 'Two collaborative robot arms with their tools, working close together',
	},
	it: {
		harness: 'Fili e morsetti dentro un quadro elettrico',
		cell: 'Il braccio di un robot collaborativo con i suoi cavi neri fascettati lungo il braccio, sopra un quadro',
		other: 'Due bracci robotici collaborativi con i loro attrezzi, che lavorano vicini',
	},
}[lang];
const pics = [
	{ src: duoHarness, alt: L.harness },
	{ src: duoCell, alt: L.cell },
	{ src: duoOther, alt: L.other },
];
---

<Compartment n={5} lang={lang} id={a.id} name={a.eyebrow} title={a.title} intro={a.intro} ground="light">
	<div class="alts">
		{
			a.items.map((it, i) => (
				<article class="alt" id={i === a.items.length - 1 ? a.workId : undefined} data-b>
					<figure class="alt__pic">
						<Image src={pics[i].src} alt={pics[i].alt} widths={[480, 720]} sizes="(min-width: 1100px) 560px, 100vw" loading="lazy" />
					</figure>
					<h3 class="alt__title">{it.title}</h3>
					<p class="alt__body">{it.body}</p>
				</article>
			))
		}
	</div>
	<p class="alts__cta" data-b>
		<a class="text-link" href="#contact">
			<span class="tl">{a.cta}</span>
			<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
		</a>
	</p>
</Compartment>

<style>
	.alts {
		display: grid;
		gap: 40px;
	}

	.alt {
		min-width: 0;
	}

	.alt__pic {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 0 0 0 var(--bend);
		background: var(--mist);
		margin-bottom: 18px;
	}

	.alt__pic :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.alt__title {
		margin-top: 0;
		font-size: 22px;
		line-height: 1.2;
	}

	.alt__body {
		margin-top: 10px;
		font-size: 16px;
		line-height: 1.55;
		max-width: 40em;
	}

	.alts__cta {
		margin-top: 32px;
	}

	@media (min-width: 700px) {
		.alts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 40px var(--gap);
		}
	}

	@media (min-width: 1100px) {
		.alt__body {
			font-size: 17px;
		}

		.alts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.alts__cta {
			margin-top: 48px;
		}
	}
</style>
