---
import Rich from '../ui/Rich.astro';
import Compartment from '../panel/Compartment.astro';
import { copy, type Lang } from '../../i18n/copy';
import { isTbd } from '../../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].team;
const linkedinTbd = lang === 'it' ? '[TBD: URL del profilo LinkedIn]' : '[TBD: LinkedIn profile URL]';
const mailSubject = encodeURIComponent(lang === 'it' ? 'Candidatura spontanea' : 'Open application');
// screen readers never hear a placeholder: the [TBD: …] part of an alt text is visual review copy only
const photoLabel = (alt: string) => alt.replace(/\[TBD:[^\]]*\]\s*/g, '').trim();
---

<Compartment n={6} lang={lang} id={t.id} name={t.eyebrow} title={t.title} intro={t.intro} ground="dark">
	<ul class="areas">
		{
			t.areas.map((a) => (
				<li data-b>
					<h3>{a.title}</h3>
					<p>{a.body}</p>
				</li>
			))
		}
	</ul>

	<div class="founders" data-b>
		<h3 class="founders__h">{t.founders.title}</h3>
		<p class="founders__intro"><Rich text={t.founders.intro} /></p>
		<ul class="people">
			{
				t.founders.people.map((person) => (
					<li class="person">
						<div class="person__photo" {...(photoLabel(person.photoAlt) ? { role: 'img', 'aria-label': photoLabel(person.photoAlt) } : { 'aria-hidden': 'true' })}>
							<svg viewBox="0 0 82.4 96" aria-hidden="true">
								<path fill="#5A6676" stroke="none" d="M 0 96 L 0 24 A 24 24 0 0 1 24 0 L 46 0 A 28 28 0 0 1 46 56 A 6 6 0 0 0 41.272 65.694 L 50.047 76.925 A 8 8 0 0 0 56.351 80 L 60.351 80 L 60.351 96 L 56.351 96 A 24 24 0 0 1 37.439 86.776 L 28.664 75.545 A 22 22 0 0 1 46 40 A 12 12 0 0 0 46 16 L 24 16 A 8 8 0 0 0 16 24 L 16 96 Z" />
							</svg>
						</div>
						<div class="person__text">
							<p class="person__name">
								<Rich text={person.name} />
							</p>
							<p class="person__role">
								<Rich text={person.role} />
							</p>
							<p class="person__bio">
								<Rich text={person.bio} />
							</p>
							<p class="person__link">
								{isTbd(person.name) ? (
									<Rich text={person.linkedinLabel} />
								) : (
									<>
										{person.linkedinLabel}: <span class="tbd">{linkedinTbd}</span>
									</>
								)}
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>

	<div class="team__foot" data-b>
		<p class="team__pubs">
			{t.publications.label}: <Rich text={t.publications.href} />
		</p>
		<p class="team__join">
			<span>{t.joinUs.text}</span>
			<a class="text-link" href={`mailto:info@robosect.it?subject=${mailSubject}`}>
				{t.joinUs.cta}
				<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
			</a>
		</p>
	</div>
</Compartment>

<style>
	.areas {
		list-style: none;
		display: grid;
		gap: 28px;
	}

	.areas h3 {
		font-size: 20px;
		line-height: 1.2;
		color: var(--paper);
	}

	.areas p {
		margin-top: 8px;
		font-size: 17px;
		line-height: 1.55;
		color: var(--paper);
	}

	.founders {
		margin-top: 56px;
	}

	.founders__h {
		font-size: 24px;
		color: var(--paper);
	}

	.founders__intro {
		margin-top: 8px;
		font-size: 17px;
	}

	.people {
		list-style: none;
		display: grid;
		gap: 8px;
		margin-top: 24px;
	}

	.person {
		display: grid;
		grid-template-columns: 88px minmax(0, 1fr);
		gap: 20px;
		padding: 16px;
		background: var(--ink-2);
	}

	.person__photo {
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		background: var(--ink);
		border-radius: 0 0 0 var(--bend);
	}

	.person__photo svg {
		width: 38%;
	}

	.person__name {
		font-size: 20px;
		font-weight: 600;
		color: var(--paper);
	}

	.person__role {
		font-size: 15px;
		color: var(--steel-light);
	}

	.person__bio {
		margin-top: 10px;
		font-size: 15px;
		line-height: 1.5;
	}

	.person__link {
		margin-top: 8px;
		font-size: 15px;
		color: var(--steel-light);
	}

	.team__foot {
		display: grid;
		gap: 16px;
		margin-top: 48px;
		font-size: 17px;
	}

	.team__join {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 20px;
		font-size: 20px;
		font-weight: 500;
		color: var(--paper);
	}

	@media (min-width: 700px) {
		.areas {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 40px var(--gap);
		}

		.people {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.person {
			grid-template-columns: 112px minmax(0, 1fr);
			padding: 20px;
		}
	}

	@media (min-width: 1100px) {
		.areas {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.founders {
			margin-top: 80px;
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gap);
		}

		.founders__h,
		.founders__intro {
			grid-column: 1 / span 4;
		}

		.founders__intro {
			grid-row: 2;
		}

		.people {
			grid-column: 5 / -1;
			grid-row: 1 / span 3;
			margin-top: 0;
		}

		.team__foot {
			margin-top: 64px;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: center;
		}

		.team__join {
			justify-content: flex-end;
		}
	}
</style>
