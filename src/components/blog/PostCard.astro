---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { copy } from '../../i18n/copy';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const b = copy.en.blog;
// a very wide cover is a logo strip, not a photograph: more room around it
const isLogo = post.data.cover.width / post.data.cover.height > 2;
const formattedDate = post.data.date.toLocaleDateString('en-GB', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<article class="post-row">
	<a class:list={['post-row__img bend', isLogo && 'is-logo']} href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
		<Image src={post.data.cover} alt="" widths={[360, 540, 720]} sizes="(min-width: 700px) 360px, 100vw" />
	</a>
	<div class="post-row__text">
		<p class="post-row__date"><time datetime={post.data.date.toISOString()}>{formattedDate}</time></p>
		<h2 class="post-row__title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
		<p class="post-row__desc">{post.data.description}</p>
		<p class="post-row__more" aria-hidden="true">
			{b.readMore}
			<svg viewBox="0 0 18 18"><path d="M2 9h12M9.5 4.5 14 9l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
		</p>
	</div>
</article>

<style>
	.post-row {
		position: relative;
		display: grid;
		gap: 20px;
	}

	.post-row__img {
		display: block;
		aspect-ratio: 3 / 2;
		background: var(--white);
	}

	/* every cover is shown whole (posters with words and logo strips among them): never cropped */
	.post-row__img :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.is-logo :global(img) {
		object-fit: contain;
		padding: 12% 10%;
	}

	.post-row__date {
		font-size: var(--t-small);
		color: var(--steel);
	}

	.post-row__title {
		margin-top: 8px;
		font-size: clamp(24px, 2.4vw, 34px);
		line-height: 1.12;
		letter-spacing: -0.02em;
	}

	.post-row__title a {
		color: var(--ink);
		text-decoration: none;
	}

	/* the whole row is the link target */
	.post-row__title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.post-row:hover .post-row__title a {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	.post-row__desc {
		margin-top: 12px;
		max-width: 56ch;
	}

	.post-row__more {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-top: 16px;
		font-family: var(--font-display);
		font-weight: 500;
		color: var(--blue);
	}

	.post-row__more svg {
		width: 18px;
		height: 18px;
		transition: transform 0.2s ease;
	}

	.post-row:hover .post-row__more svg {
		transform: translateX(3px);
	}

	.post-row:has(a:focus-visible) {
		outline: 3px solid var(--cu);
		outline-offset: 8px;
	}

	.post-row__title a:focus-visible {
		outline: none;
	}

	@media (min-width: 700px) {
		.post-row {
			grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
			gap: var(--gap);
			align-items: center;
		}
	}
</style>
