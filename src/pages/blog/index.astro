---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { copy } from '../../i18n/copy';

const b = copy.en.blog;
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title={b.metaTitle} description={b.metaDescription} lang="en">
	<PageHeader title={b.title} intro={b.intro} />
	<section class="news wrap" aria-label={b.title}>
		{posts.length === 0 && <p>{b.empty}</p>}
		<div class="news__list">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</BaseLayout>

<style>
	.news {
		padding-block: clamp(64px, 8vw, 120px) clamp(96px, 10vw, 152px);
		background: var(--paper);
	}

	.news__list {
		display: grid;
		gap: clamp(56px, 7vw, 96px);
	}
</style>
